{
 "cells": [
  {
   "cell_type": "markdown",
   "id": "19eec4bc",
   "metadata": {},
   "source": [
    "# AF-BP benchmark analysis\n",
    "\n",
    "This notebook reads one `benchmark_results/3` run, or a previous `/2` run without convergence data. Each saved Parquet file is one physical code/noise condition. Rows contain `shot_id`, `decoder_name`, `logical_error`, `latency_ns`, and `total_iterations`; new rows also contain convergence and AF-BP stage flags. Figures use saved paired shots. The notebook performs no decoding or resampling."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d733a5ca",
   "metadata": {},
   "outputs": [],
   "source": [
    "from pathlib import Path\n",
    "import json\n",
    "import os\n",
    "import sys\n",
    "ROOT = next(p for p in (Path.cwd(), *Path.cwd().parents) if (p / \"pyproject.toml\").is_file())\n",
    "sys.path.insert(0, str(ROOT))\n",
    "get_ipython().run_line_magic(\"matplotlib\", \"inline\")\n",
    "from matplotlib_inline.backend_inline import set_matplotlib_formats\n",
    "set_matplotlib_formats(\"png\")\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "from IPython.display import display\n",
    "import analysis\n",
    "from analysis import (list_run_conditions, summarize_run, plot_logical_error_rate, plot_convergence_rate,\n",
    "                      plot_mean_decode_time, plot_mean_total_iterations,\n",
    "                      plot_decode_time_histogram)\n",
    "from qec_bp_benchmark.storage.minimal import SCHEMA_VERSION\n",
    "\n",
    "RUN_PATH = Path(os.environ.get(\"QEC_ANALYSIS_RUN\",\n",
    "    ROOT / \"assets/runs/2026_09_25_22_46_d822b5bc\")).expanduser().resolve()\n",
    "if Path(analysis.__file__).resolve().parent != (ROOT / \"analysis\").resolve():\n",
    "    raise RuntimeError(f\"Analysis loaded from another checkout: {analysis.__file__}\")\n",
    "resolved_config = json.loads((RUN_PATH / \"config_resolved.json\").read_text())\n",
    "conditions = list_run_conditions(RUN_PATH)\n",
    "CODES = None\n",
    "PHYSICAL_RATES = None\n",
    "DISTANCES = None\n",
    "DECODERS = None\n",
    "CONFIDENCE = 0.95\n",
    "HISTOGRAM_BINS = 60\n",
    "FIGURE_OUTPUT = ROOT / \"assets/analysis\" / RUN_PATH.name\n",
    "FIGURE_OUTPUT.mkdir(parents=True, exist_ok=True)\n",
    "saved_figures = []\n",
    "\n",
    "def matches(value, selector):\n",
    "    if selector is None:\n",
    "        return True\n",
    "    selected = selector if isinstance(selector, (list, tuple, set)) else (selector,)\n",
    "    return value in selected\n",
    "\n",
    "selected_conditions = [c for c in conditions if matches(c.family, CODES)\n",
    "                       and matches(c.distance, DISTANCES)\n",
    "                       and matches(c.physical_rate, PHYSICAL_RATES)]\n",
    "if not selected_conditions:\n",
    "    raise ValueError(\"The filters match no saved condition\")\n",
    "print(f\"Run: {RUN_PATH}\")\n",
    "print(f\"Saved schemas: {sorted({c.schema_version for c in selected_conditions})}\")\n",
    "print(f\"Saved condition files: {len(selected_conditions)}\")\n",
    "print(f\"Figures: {FIGURE_OUTPUT}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "8e7fee3b",
   "metadata": {},
   "source": [
    "## Saved condition statistics\n",
    "\n",
    "Each logical error denominator is a physical shot; all BB observables form one block trial. Wilson intervals summarize logical errors. Latency and iteration statistics include failed decodes."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "4aafe6c6",
   "metadata": {},
   "outputs": [],
   "source": [
    "summaries = summarize_run(RUN_PATH, confidence=CONFIDENCE)\n",
    "selected_ids = {c.result_path.name.removesuffix(\"_results.parquet\") for c in selected_conditions}\n",
    "summary_table = pd.DataFrame([{\n",
    "    \"condition\": row[\"condition_id\"],\n",
    "    \"code\": row[\"family\"],\n",
    "    \"distance\": row[\"distance\"],\n",
    "    \"rounds\": row[\"rounds\"],\n",
    "    \"physical_rate\": row[\"physical_rate\"],\n",
    "    \"decoder\": row[\"decoder_name\"],\n",
    "    \"shots\": row[\"shots\"],\n",
    "    \"logical_errors\": row[\"logical_errors\"],\n",
    "    \"logical_error_rate\": row[\"logical_error_rate\"][\"rate\"],\n",
    "    \"convergence_rate\": (row[\"convergence_rate\"] or {}).get(\"rate\"),\n",
    "    \"logical_error_given_converged\": (row[\"logical_error_given_converged\"] or {}).get(\"rate\"),\n",
    "    \"initial_bp_convergence_rate\": (row[\"initial_bp_convergence_rate\"] or {}).get(\"rate\"),\n",
    "    \"first_transform_rescue_rate\": (row[\"first_transform_rescue_rate\"] or {}).get(\"rate\"),\n",
    "    \"logical_ci_low\": row[\"logical_error_rate\"][\"low\"],\n",
    "    \"logical_ci_high\": row[\"logical_error_rate\"][\"high\"],\n",
    "    \"mean_wall_ms\": row[\"latency_ns\"][\"mean_ns\"] / 1e6,\n",
    "    \"median_wall_ms\": row[\"latency_ns\"][\"median_ns\"] / 1e6,\n",
    "    \"p95_wall_ms\": row[\"latency_ns\"][\"p95_ns\"] / 1e6,\n",
    "    \"p99_wall_ms\": row[\"latency_ns\"][\"p99_ns\"] / 1e6,\n",
    "    \"mean_total_iterations\": row[\"total_iterations\"][\"mean\"],\n",
    "    \"median_total_iterations\": row[\"total_iterations\"][\"median\"],\n",
    "} for row in summaries if row[\"condition_id\"] in selected_ids\n",
    "    and matches(row[\"decoder_name\"], DECODERS)\n",
    "]).sort_values([\"code\", \"distance\", \"physical_rate\", \"decoder\"]).reset_index(drop=True)\n",
    "if summary_table.empty:\n",
    "    raise ValueError(\"The decoder filter matches no saved results\")\n",
    "display(summary_table)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "6eee29d4",
   "metadata": {},
   "source": [
    "## Logical error rate\n",
    "\n",
    "Shading is a two-sided Wilson interval. One saved physical rate yields one point per decoder and cannot show a rate trend."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "64caf519",
   "metadata": {},
   "outputs": [],
   "source": [
    "logical_error_figures = plot_logical_error_rate(\n",
    "    RUN_PATH, codes=CODES, physical_rates=PHYSICAL_RATES, distances=DISTANCES,\n",
    "    decoders=DECODERS, confidence=CONFIDENCE,\n",
    ")\n",
    "for figure in logical_error_figures:\n",
    "    family = figure.axes[0].get_title()\n",
    "    for suffix in (\"png\", \"pdf\"):\n",
    "        path = FIGURE_OUTPUT / f\"logical_error_rate_{family}.{suffix}\"\n",
    "        figure.savefig(path, dpi=300)\n",
    "        saved_figures.append(path)\n",
    "    display(figure)\n",
    "    plt.close(figure)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a825ad29",
   "metadata": {},
   "source": [
    "## Syndrome-valid convergence\n",
    "\n",
    "New `benchmark_results/3` files record convergence separately from logical error. For BP-OSD, this is BP-stage convergence before OSD. The table above also gives `P(logical_error | converged)`. AF-BP first-transform rescue is conditional on initial BP failure; skipped transforms count as no rescue."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "01ecddde",
   "metadata": {},
   "outputs": [],
   "source": [
    "if all(c.schema_version == SCHEMA_VERSION for c in selected_conditions):\n",
    "    convergence_figures = plot_convergence_rate(\n",
    "        RUN_PATH, codes=CODES, physical_rates=PHYSICAL_RATES,\n",
    "        distances=DISTANCES, decoders=DECODERS, confidence=CONFIDENCE,\n",
    "    )\n",
    "    for figure in convergence_figures:\n",
    "        family = figure.axes[0].get_title()\n",
    "        for suffix in (\"png\", \"pdf\"):\n",
    "            path = FIGURE_OUTPUT / f\"convergence_rate_{family}.{suffix}\"\n",
    "            figure.savefig(path, dpi=300)\n",
    "            saved_figures.append(path)\n",
    "        display(figure)\n",
    "        plt.close(figure)\n",
    "else:\n",
    "    print(\"Convergence was not saved in benchmark_results/2; no value is inferred.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0867d280",
   "metadata": {},
   "source": [
    "## Mean complete-service wall latency\n",
    "\n",
    "Every saved shot contributes, including failures. Shading is a two-sided Student-t interval for the arithmetic mean. Throughput-mode wall time includes worker contention."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "fd1634da",
   "metadata": {},
   "outputs": [],
   "source": [
    "decode_time_figures = plot_mean_decode_time(\n",
    "    RUN_PATH, codes=CODES, physical_rates=PHYSICAL_RATES, distances=DISTANCES,\n",
    "    decoders=DECODERS, clock=\"wall\", confidence=CONFIDENCE,\n",
    ")\n",
    "for figure in decode_time_figures:\n",
    "    family = figure.axes[0].get_title()\n",
    "    for suffix in (\"png\", \"pdf\"):\n",
    "        path = FIGURE_OUTPUT / f\"mean_wall_latency_{family}.{suffix}\"\n",
    "        figure.savefig(path, dpi=300)\n",
    "        saved_figures.append(path)\n",
    "    display(figure)\n",
    "    plt.close(figure)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "764b6621",
   "metadata": {},
   "source": [
    "## Mean total BP iterations\n",
    "\n",
    "These are exact saved totals across BP calls; OSD adds zero BP iterations. Shading is a two-sided Student-t interval for the mean."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "66008d21",
   "metadata": {},
   "outputs": [],
   "source": [
    "iteration_figures = plot_mean_total_iterations(\n",
    "    RUN_PATH, codes=CODES, physical_rates=PHYSICAL_RATES, distances=DISTANCES,\n",
    "    decoders=DECODERS, confidence=CONFIDENCE,\n",
    ")\n",
    "for figure in iteration_figures:\n",
    "    family = figure.axes[0].get_title()\n",
    "    for suffix in (\"png\", \"pdf\"):\n",
    "        path = FIGURE_OUTPUT / f\"mean_total_iterations_{family}.{suffix}\"\n",
    "        figure.savefig(path, dpi=300)\n",
    "        saved_figures.append(path)\n",
    "    display(figure)\n",
    "    plt.close(figure)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c1eab734",
   "metadata": {},
   "source": [
    "## Wall-latency distribution for every saved condition\n",
    "\n",
    "Each decoder has its own panel. Vertical lines mark mean, p95 and p99. The tails are descriptive for the saved shot count."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "eb1a3fda",
   "metadata": {},
   "outputs": [],
   "source": [
    "histogram_figures = {}\n",
    "for condition in selected_conditions:\n",
    "    figure = plot_decode_time_histogram(\n",
    "        RUN_PATH, code=condition.family, physical_rate=condition.physical_rate,\n",
    "        distance=condition.distance, rounds=condition.rounds,\n",
    "        decoders=DECODERS, clock=\"wall\",\n",
    "        bins=HISTOGRAM_BINS,\n",
    "    )\n",
    "    condition_id = condition.result_path.name.removesuffix(\"_results.parquet\")\n",
    "    histogram_figures[condition_id] = figure\n",
    "    for suffix in (\"png\", \"pdf\"):\n",
    "        path = FIGURE_OUTPUT / f\"wall_latency_histogram_{condition_id}.{suffix}\"\n",
    "        figure.savefig(path, dpi=300)\n",
    "        saved_figures.append(path)\n",
    "    display(figure)\n",
    "    plt.close(figure)\n",
    "print(\"Saved figures:\")\n",
    "for path in saved_figures:\n",
    "    print(path)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "14fcd49a",
   "metadata": {},
   "source": [
    "## Decoder settings and limits\n",
    "\n",
    "The saved result schema cannot recover correction vectors, per-observable outcomes, CPU time, decoder phases, or legacy search events. A bounded run cannot establish production accuracy, tail latency, or decoder superiority."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "d997d447",
   "metadata": {},
   "outputs": [],
   "source": [
    "decoder_parameters = pd.json_normalize(resolved_config[\"decoders\"], sep=\".\")\n",
    "display(decoder_parameters)"
   ]
  }
 ],
 "metadata": {
  "kernelspec": {
   "display_name": "Python (search_decimation)",
   "language": "python",
   "name": "search_decimation"
  }
 },
