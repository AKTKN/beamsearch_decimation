+"""Build opt-in hybrid interfaces without changing upstream or reference APIs."""
+from pathlib import Path
+import runpy
+import subprocess
+from setuptools import Extension, setup
+import pybind11
+
+ROOT = Path(__file__).resolve().parent
+sources = runpy.run_path(str(ROOT / 'src_python/ldpc/hybrid_bp/source_files.py'))
+digest = sources['source_digest'](ROOT)
+commit = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
+setup(package_dir={'': 'src_python'}, ext_modules=[Extension(
+    'ldpc.hybrid_bp._hybrid_bp', sources=['src_python/ldpc/hybrid_bp/bindings.cpp'],
+    depends=list(sources['SOURCE_FILES']), include_dirs=[pybind11.get_include(), 'src_cpp'], language='c++',
+    define_macros=[('HYBRID_UPSTREAM_COMMIT', '"' + commit + '"'), ('HYBRID_SOURCE_HASH', '"' + digest + '"')],
+    extra_compile_args=['-O3', '-std=c++17', '-fno-fast-math', '-ffp-contract=off', '-Wall', '-Wextra'])])
