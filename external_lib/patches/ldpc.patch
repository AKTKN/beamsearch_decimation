+from typing import Sequence
+class Snapshot:
+    fields: list[float]
+    sums: list[float]
+    llrs: list[float]
+    q: list[float]
+    z: list[float]
+    decision: list[int]
+    syndrome: list[int]
+    iterations: int
+    model_id: int
+    shot_id: int
+    numeric_id: int
+class Advance:
+    valid: bool
+    cap_hit: bool
+    iterations: int
+class OsdResult:
+    correction: list[int]
+    valid: bool
+class StatefulMinSumSession:
+    def __init__(self, rows: Sequence[Sequence[int]], n: int, probabilities: Sequence[float], llr_clip: float = 25., scaling_factor: float = 1.) -> None: ...
+    def reset(self, syndrome: Sequence[int], shot_id: int = 0) -> None: ...
+    def replace_fields(self, fields: Sequence[float]) -> bool: ...
+    def replace_hint(self, pattern: Sequence[tuple[int, int]], margin: float) -> bool: ...
+    def advance(self, iterations: int) -> Advance: ...
+    def snapshot(self) -> Snapshot: ...
+    def restore(self, snapshot: Snapshot, shot_id: int) -> None: ...
+    @property
+    def snapshot_bytes(self) -> int: ...
+class Osd0Bridge:
+    def __init__(self, rows: Sequence[Sequence[int]], n: int, probabilities: Sequence[float]) -> None: ...
+    def decode(self, syndrome: Sequence[int], llrs: Sequence[float]) -> OsdResult: ...
+    @property
+    def candidate_count(self) -> int: ...
+def build_identity() -> dict[str, str]: ...
+
+# Opt-in structural decimation API. Arrays returned to Python are detached copies.
+from enum import Enum
+class DecimatedBPStatus(Enum):
+    READY = 0
+    CONVERGED = 1
+    LOCAL_CONTRADICTION = 2
+    BUDGET_EXHAUSTED = 3
+class DecimatedBPAdvance:
+    requested_iterations: int
+    actual_iterations: int
+    total_iterations: int
+    status: DecimatedBPStatus
+    @property
+    def valid(self) -> bool: ...
+class DecimatedBPSnapshot:
+    @property
+    def q(self) -> list[float]: ...
+    @property
+    def check_to_variable(self) -> list[float]: ...
+    @property
+    def posterior_llr(self) -> list[float]: ...
+    @property
+    def fixed(self) -> list[int]: ...
+    @property
+    def syndrome(self) -> list[int]: ...
+    @property
+    def shot_id(self) -> int: ...
+    @property
+    def total_iterations(self) -> int: ...
+    @property
+    def history_count(self) -> int: ...
+    @property
+    def history_window(self) -> int: ...
+    @property
+    def payload_bytes(self) -> int: ...
+class DecimatedMinSumSession:
+    def __init__(self, rows: Sequence[Sequence[int]], n: int, probabilities: Sequence[float], history_window: int = 8, history_clip: float = 25., scaling_factor: float = 1.) -> None: ...
+    def reset_from_channel(self, syndrome: Sequence[int], fixed: Sequence[tuple[int, int]] = (), shot_id: int = 0) -> None: ...
+    def continue_iterations(self, requested_iterations: int) -> DecimatedBPAdvance: ...
+    def snapshot(self) -> DecimatedBPSnapshot: ...
+    def restore(self, snapshot: DecimatedBPSnapshot) -> None: ...
+    def inherit_descendant(self, snapshot: DecimatedBPSnapshot, additional_fixations: Sequence[tuple[int, int]]) -> None: ...
+    @property
+    def status(self) -> DecimatedBPStatus: ...
+    @property
+    def decision(self) -> list[int]: ...
+    @property
+    def posterior_llr(self) -> list[float]: ...
+    @property
+    def check_to_variable(self) -> list[float]: ...
+    @property
+    def clipped_mean_llr(self) -> list[float]: ...
+    @property
+    def residual_syndrome(self) -> list[int]: ...
+    @property
+    def fixed(self) -> list[int]: ...
+    @property
+    def total_iterations(self) -> int: ...
+    @property
+    def history_count(self) -> int: ...
+    @property
+    def snapshot_payload_bytes(self) -> int: ...
