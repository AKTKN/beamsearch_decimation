+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+#include "af_bp.hpp"
+namespace py = pybind11;
+using namespace ldpc::af_bp;
+
+PYBIND11_MODULE(_af_bp, m) {
+    m.doc() = "Opt-in C++ parallel, horizontal serial, and qDither Min-Sum.";
+    m.def("build_identity", []() {
+        py::dict out;
+        out["upstream_commit"] = AF_BP_UPSTREAM_COMMIT;
+        out["source_sha256"] = AF_BP_SOURCE_HASH;
+        out["flags"] = "-O3 -std=c++17 -fno-fast-math -ffp-contract=off";
+        return out;
+    });
+    py::class_<Settings>(m, "Settings")
+        .def(py::init<>())
+        .def_readwrite("variant", &Settings::variant)
+        .def_readwrite("max_iterations", &Settings::max_iterations)
+        .def_readwrite("scaling_factor", &Settings::scaling_factor)
+        .def_readwrite("history_window", &Settings::history_window)
+        .def_readwrite("serial_order", &Settings::serial_order)
+        .def_readwrite("seed", &Settings::seed)
+        .def_readwrite("phase1_iterations", &Settings::phase1_iterations)
+        .def_readwrite("num_chains", &Settings::num_chains)
+        .def_readwrite("chain_iterations", &Settings::chain_iterations)
+        .def_readwrite("alpha", &Settings::alpha)
+        .def_readwrite("beta", &Settings::beta)
+        .def_readwrite("rho", &Settings::rho)
+        .def_readwrite("qdither_handoff", &Settings::qdither_handoff)
+        .def_readwrite("max_total_iterations", &Settings::max_total_iterations);
+    py::class_<StepTrace>(m, "StepTrace")
+        .def_readonly("order", &StepTrace::order)
+        .def_readonly("check_to_variable", &StepTrace::check_to_variable)
+        .def_readonly("variable_to_check", &StepTrace::variable_to_check)
+        .def_readonly("provisional_variable_to_check", &StepTrace::provisional_variable_to_check)
+        .def_readonly("marginals", &StepTrace::marginals);
+    py::class_<AttemptTrace>(m, "AttemptTrace")
+        .def_readonly("bias", &AttemptTrace::bias)
+        .def_readonly("initial_messages", &AttemptTrace::initial_messages)
+        .def_readonly("chi", &AttemptTrace::chi)
+        .def_readonly("rsf_mask", &AttemptTrace::rsf_mask)
+        .def_readonly("steps", &AttemptTrace::steps);
+    py::class_<Result>(m, "Result")
+        .def_readonly("success", &Result::success)
+        .def_readonly("correction", &Result::correction)
+        .def_readonly("final_llrs", &Result::final_llrs)
+        .def_readonly("total_iterations", &Result::total_iterations)
+        .def_readonly("phase1_iterations_executed", &Result::phase1_iterations_executed)
+        .def_readonly("chain_iterations_executed", &Result::chain_iterations_executed)
+        .def_readonly("trailing_history", &Result::trailing_history)
+        .def_readonly("attempts", &Result::attempts)
+        .def_readonly("budget_truncated", &Result::budget_truncated);
+    py::class_<Decoder>(m, "Decoder")
+        .def(py::init<Rows, Reals, Settings>(), py::arg("rows"), py::arg("base_llrs"), py::arg("settings"))
+        .def("decode_detailed", &Decoder::decode, py::arg("syndrome"),
+             py::arg("q_init")=Reals{}, py::arg("diagnostics")=false,
+             py::call_guard<py::gil_scoped_release>());
+}
