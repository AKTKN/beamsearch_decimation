--- /dev/null
+++ b/src_cpp/README.reference_bp.md
@@ -0,0 +1,10 @@
+# Opt-in reference_bp.hpp addition
+
+ReferenceBp owns sorted graph/prior copies and has a const decode API. Per-call
+active adjacency removes fixed zeros and ones; original IDs are retained. Two
+message buffers enforce flooding barriers. Returned Result/Trace objects own their
+vectors and have no borrowed lifetimes. Concurrent calls do not share mutable state.
+
+This addition does not modify bp.hpp or ordinary BP-OSD. The benchmark's
+README under the Python reference_bp binding and docs/reference_bp.md describe
+numerics, shapes, test evidence and the explicit build. No search code lives here.
diff --git a/src_cpp/af_bp.hpp b/src_cpp/af_bp.hpp
new file mode 100644
index 0000000..5d2f520
--- /dev/null
+++ b/src_cpp/af_bp.hpp
@@ -0,0 +1,256 @@
+#pragma once
+
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <limits>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ldpc::af_bp {
+using Rows = std::vector<std::vector<int>>;
+using Reals = std::vector<double>;
+using Bits = std::vector<int>;
+
+struct Settings {
+    std::string variant = "parallel";
+    int max_iterations = 30;
+    double scaling_factor = 1.0;
+    int history_window = 8;
+    std::string serial_order = "natural";
+    std::uint64_t seed = 0;
+    int phase1_iterations = 30;
+    int num_chains = 0;
+    int chain_iterations = 30;
+    double alpha = 0.0;
+    double beta = 1.0;
+    double rho = 0.0;
+    std::string qdither_handoff = "paper";
+    int max_total_iterations = -1;
+};
+
+struct StepTrace {
+    Bits order;
+    Reals check_to_variable;
+    Reals variable_to_check;
+    Reals provisional_variable_to_check;
+    Reals marginals;
+};
+
+struct AttemptTrace {
+    Reals bias;
+    Reals initial_messages;
+    Reals chi;
+    Bits rsf_mask;
+    std::vector<StepTrace> steps;
+};
+
+struct Result {
+    bool success = false;
+    Bits correction;
+    Reals final_llrs;
+    int total_iterations = 0;
+    int phase1_iterations_executed = 0;
+    std::vector<int> chain_iterations_executed;
+    std::vector<Reals> trailing_history;
+    std::vector<AttemptTrace> attempts;
+    bool budget_truncated = false;
+};
+
+class Decoder {
+    Rows rows_;
+    Reals base_;
+    Settings cfg_;
+    int n_;
+    std::vector<std::vector<int>> row_edges_, var_edges_;
+    Bits edge_var_;
+
+    static int sign(double x) { return (x > 0) - (x < 0); }
+
+    bool valid(const Bits& hard, const Bits& syndrome) const {
+        for (std::size_t a = 0; a < rows_.size(); ++a) {
+            int parity = 0;
+            for (int v : rows_[a]) parity ^= hard[v];
+            if (parity != syndrome[a]) return false;
+        }
+        return true;
+    }
+
+    Reals marginals(const Reals& bias, const Reals& check) const {
+        Reals out = bias;
+        for (int v = 0; v < n_; ++v)
+            for (int e : var_edges_[v]) out[v] += check[e];
+        return out;
+    }
+
+    void check_row(int a, const Reals& variable, Reals& check, int syndrome_bit) const {
+        const auto& edges = row_edges_[a];
+        for (int e : edges) {
+            int parity_sign = syndrome_bit ? -1 : 1;
+            double minimum = std::numeric_limits<double>::infinity();
+            for (int other : edges) if (other != e) {
+                parity_sign *= sign(variable[other]);
+                minimum = std::min(minimum, std::abs(variable[other]));
+            }
+            // A unary check is an exact parity constraint. A finite sentinel
+            // avoids inf-inf cancellation in contradictory sparse graphs.
+            if (edges.size() == 1) minimum = 1e12;
+            check[e] = cfg_.scaling_factor * parity_sign * minimum;
+        }
+    }
+
+    bool attempt(const Bits& syndrome, const Reals& bias, const Reals& initial,
+                 int budget, std::mt19937_64& rng, const Bits& mask,
+                 int& used, Reals& final, Bits& hard,
+                 std::vector<Reals>& history, AttemptTrace* trace) const {
+        Reals variable(edge_var_.size()), check(edge_var_.size(), 0.0);
+        for (std::size_t e = 0; e < variable.size(); ++e) variable[e] = initial[edge_var_[e]];
+        if (trace) trace->initial_messages = variable;
+        final = bias;
+        hard.resize(n_);
+        for (int v = 0; v < n_; ++v) hard[v] = final[v] <= 0.0;
+        // The initial prior-only decision is observable but consumes no iteration.
+        if (valid(hard, syndrome)) return true;
+        for (int t = 0; t < budget; ++t) {
+            StepTrace step;
+            const Reals old_variable = mask.empty() ? Reals{} : variable;
+            if (cfg_.variant == "serial") {
+                step.order.resize(rows_.size());
+                std::iota(step.order.begin(), step.order.end(), 0);
+                if (cfg_.serial_order == "random_per_iteration")
+                    std::shuffle(step.order.begin(), step.order.end(), rng);
+                for (int a : step.order) {
+                    check_row(a, variable, check, syndrome[a]);
+                    // Recompute every affected variable immediately. Recomputing
+                    // avoids subtractive cancellation from previous messages.
+                    for (int e : row_edges_[a]) {
+                        const int v = edge_var_[e];
+                        double sum = bias[v];
+                        for (int other : var_edges_[v]) sum += check[other];
+                        for (int other : var_edges_[v]) variable[other] = sum - check[other];
+                    }
+                }
+            } else {
+                Reals next = check;
+                for (int a = 0; a < static_cast<int>(rows_.size()); ++a)
+                    check_row(a, variable, next, syndrome[a]);
+                check.swap(next);
+                for (int v = 0; v < n_; ++v) {
+                    double sum = bias[v];
+                    for (int e : var_edges_[v]) sum += check[e];
+                    for (int e : var_edges_[v]) variable[e] = sum - check[e];
+                }
+            }
+            step.provisional_variable_to_check = variable;
+            if (!mask.empty()) {
+                // The old edge state must precede this complete iteration.
+                for (std::size_t e = 0; e < variable.size(); ++e)
+                    if (mask[edge_var_[e]] && sign(variable[e]) != sign(old_variable[e]))
+                        variable[e] += old_variable[e];
+            }
+            final = marginals(bias, check);
+            for (int v = 0; v < n_; ++v) hard[v] = final[v] <= 0.0;
+            ++used;
+            history.push_back(final);
+            if (static_cast<int>(history.size()) > cfg_.history_window) history.erase(history.begin());
+            if (trace) {
+                step.check_to_variable = check;
+                step.variable_to_check = variable;
+                step.marginals = final;
+                trace->steps.push_back(std::move(step));
+            }
+            if (valid(hard, syndrome)) return true;
+        }
+        return false;
+    }
+
+public:
+    Decoder(Rows rows, Reals base, Settings cfg) : rows_(std::move(rows)),
+        base_(std::move(base)), cfg_(std::move(cfg)), n_(static_cast<int>(base_.size())) {
+        if (cfg_.variant != "parallel" && cfg_.variant != "serial" && cfg_.variant != "qdither")
+            throw std::invalid_argument("variant must be parallel, serial, or qdither");
+        if (cfg_.serial_order != "natural" && cfg_.serial_order != "random_per_iteration")
+            throw std::invalid_argument("invalid serial_order");
+        if (cfg_.qdither_handoff != "paper" && cfg_.qdither_handoff != "graph_warm")
+            throw std::invalid_argument("invalid qdither_handoff");
+        if (cfg_.max_iterations < 0 || cfg_.history_window < 1 ||
+            cfg_.phase1_iterations < 0 || cfg_.num_chains < 0 || cfg_.chain_iterations < 0 ||
+            cfg_.max_total_iterations < -1 ||
+            !(cfg_.scaling_factor > 0 && cfg_.scaling_factor <= 1) ||
+            !(cfg_.alpha >= 0 && cfg_.alpha <= cfg_.beta && cfg_.beta <= 1) ||
+            !(cfg_.rho >= 0 && cfg_.rho <= 1))
+            throw std::invalid_argument("invalid BP settings");
+        for (double x : base_) if (!std::isfinite(x)) throw std::invalid_argument("base LLRs must be finite");
+        row_edges_.resize(rows_.size()); var_edges_.resize(n_);
+        for (std::size_t a = 0; a < rows_.size(); ++a) {
+            int previous = -1;
+            for (int v : rows_[a]) {
+                if (v < 0 || v >= n_ || v <= previous)
+                    throw std::invalid_argument("row indices must be sorted unique and in range");
+                previous = v;
+                const int e = static_cast<int>(edge_var_.size());
+                edge_var_.push_back(v); row_edges_[a].push_back(e); var_edges_[v].push_back(e);
+            }
+        }
+    }
+
+    Result decode(const Bits& syndrome, const Reals& q_init = {}, bool diagnostics = false) const {
+        if (syndrome.size() != rows_.size() ||
+            std::any_of(syndrome.begin(), syndrome.end(), [](int b){ return b != 0 && b != 1; }))
+            throw std::invalid_argument("syndrome must be a binary vector with one entry per check");
+        if (!q_init.empty() && (q_init.size() != base_.size() ||
+            std::any_of(q_init.begin(), q_init.end(), [](double x){ return !std::isfinite(x); })))
+            throw std::invalid_argument("q_init must be a finite length-n vector");
+        if (cfg_.variant == "qdither" && cfg_.qdither_handoff == "paper" && !q_init.empty())
+            throw std::invalid_argument("paper qDither does not accept q_init");
+        Result result;
+        std::mt19937_64 rng(cfg_.seed);
+        const Reals& first = q_init.empty() ? base_ : q_init;
+        auto cap = [&](int nominal) {
+            return cfg_.max_total_iterations < 0 ? nominal :
+                std::min(nominal, std::max(0, cfg_.max_total_iterations - result.total_iterations));
+        };
+        auto run = [&](const Reals& bias, const Reals& initial, int nominal,
+                       const Bits& mask, const Reals& chi, bool phase1) {
+            const int budget = cap(nominal);
+            AttemptTrace trace; trace.bias = bias; trace.chi = chi; trace.rsf_mask = mask;
+            int used = 0;
+            result.trailing_history.clear();
+            bool success = attempt(syndrome, bias, initial, budget, rng, mask, used,
+                                   result.final_llrs, result.correction,
+                                   result.trailing_history, diagnostics ? &trace : nullptr);
+            if (!success && budget < nominal) result.budget_truncated = true;
+            result.total_iterations += used;
+            if (phase1) result.phase1_iterations_executed = used;
+            else result.chain_iterations_executed.push_back(used);
+            if (diagnostics) result.attempts.push_back(std::move(trace));
+            result.success = success;
+        };
+        run(base_, first, cfg_.variant == "qdither" ? cfg_.phase1_iterations : cfg_.max_iterations,
+            {}, {}, true);
+        if (result.success || cfg_.variant != "qdither") return result;
+        Reals inherited = base_;  // paper q^(0), independent of Phase-I failure marginals
+        std::uniform_real_distribution<double> uniform(cfg_.alpha, cfg_.beta);
+        std::bernoulli_distribution bernoulli(cfg_.rho);
+        for (int r = 0; r < cfg_.num_chains; ++r) {
+            if (cfg_.max_total_iterations >= 0 && result.total_iterations >= cfg_.max_total_iterations) {
+                result.budget_truncated = true;
+                break;
+            }
+            Reals bias(n_); Reals chi(n_); Bits mask(n_);
+            for (int v = 0; v < n_; ++v) {
+                chi[v] = uniform(rng);
+                bias[v] = (1.0 - chi[v]) * base_[v] + chi[v] * inherited[v];
+                mask[v] = bernoulli(rng);
+            }
+            run(bias, bias, cfg_.chain_iterations, mask, chi, false);
+            if (result.success) break;
+            inherited = result.final_llrs;
+        }
+        return result;
+    }
+};
+}  // namespace ldpc::af_bp
diff --git a/src_cpp/decimated_bp.hpp b/src_cpp/decimated_bp.hpp
new file mode 100644
index 0000000..6ed6f58
--- /dev/null
+++ b/src_cpp/decimated_bp.hpp
@@ -0,0 +1,257 @@
+#ifndef LDPC_DECIMATED_BP_HPP
+#define LDPC_DECIMATED_BP_HPP
+
+#include "hybrid_graph.hpp"
+#include <limits>
+#include <memory>
+
+namespace ldpc::decimated {
+using hybrid::Bits;
+using hybrid::Graph;
+using hybrid::Reals;
+using Pattern = std::vector<std::pair<int, int>>;
+
+enum class Status { Ready, Converged, LocalContradiction, BudgetExhausted };
+struct Advance {
+    uint64_t requested_iterations = 0, actual_iterations = 0, total_iterations = 0;
+    Status status = Status::Ready;
+    bool valid() const { return status == Status::Converged; }
+};
+
+// Immutable-by-interface owned snapshot. decision, residual and mean are
+// derived/work buffers and are deliberately not copied. No graph is copied.
+class Snapshot {
+    friend class Session;
+    Reals q_, z_, llrs_, history_, sums_;
+    std::vector<int8_t> fixed_;
+    Bits syndrome_;
+    uint64_t model_id_ = 0, shot_id_ = 0, iterations_ = 0;
+    size_t window_ = 0, count_ = 0, cursor_ = 0;
+    double alpha_ = 1, clip_ = 25;
+    Snapshot() = default;
+public:
+    Snapshot(const Snapshot&) = default;
+    Snapshot(Snapshot&&) noexcept = default;
+    Snapshot& operator=(const Snapshot&) = default;
+    Snapshot& operator=(Snapshot&&) noexcept = default;
+    const Reals& q() const { return q_; }
+    const Reals& check_to_variable() const { return z_; }
+    const Reals& llrs() const { return llrs_; }
+    const std::vector<int8_t>& fixed() const { return fixed_; }
+    const Bits& syndrome() const { return syndrome_; }
+    uint64_t shot_id() const { return shot_id_; }
+    uint64_t iterations() const { return iterations_; }
+    size_t history_count() const { return count_; }
+    size_t history_window() const { return window_; }
+    // Vector payload only: excludes vector/control objects, capacities and allocator overhead.
+    size_t payload_bytes() const {
+        return sizeof(double) * (q_.size() + z_.size() + llrs_.size() + history_.size() + sums_.size())
+            + sizeof(int8_t) * fixed_.size() + sizeof(uint8_t) * syndrome_.size();
+    }
+};
+
+// Non-reentrant, worker-owned session, sharing an immutable graph. All arrays
+// allocate at construction; iterations/reset/inheritance reuse their capacities.
+// Native const array views last only until the next mutation; snapshots own copies.
+class Session {
+    std::shared_ptr<const Graph> graph_;
+    Snapshot state_;
+    Bits decision_, residual_;
+    bool ready_ = false, contradiction_ = false;
+
+    void require_ready() const {
+        if (!ready_) throw std::logic_error("reset_from_channel required before BP access");
+    }
+    bool active(size_t edge) const { return state_.fixed_[graph_->col[edge]] < 0; }
+    static double add(double a, double b) {
+        constexpr double top = std::numeric_limits<double>::max();
+        if (b > 0 && a > top - b) return top;
+        if (b < 0 && a < -top - b) return -top;
+        return a + b;
+    }
+    double clip(double x) const { return std::max(-state_.clip_, std::min(state_.clip_, x)); }
+    void validate_pattern(const Pattern& pattern, bool additional) const {
+        int previous = -1;
+        if (additional && pattern.empty()) throw std::invalid_argument("descendant requires additional fixations");
+        for (auto [j, bit] : pattern) {
+            if (j <= previous || j < 0 || j >= graph_->n || (bit != 0 && bit != 1))
+                throw std::invalid_argument("fixations must be sorted unique in-range binary assignments");
+            if (additional && state_.fixed_[j] >= 0)
+                throw std::invalid_argument("additional fixation overlaps an ancestor fixation");
+            previous = j;
+        }
+    }
+    void reconstruct() {
+        residual_ = state_.syndrome_;
+        for (int j = 0; j < graph_->n; ++j) {
+            const int bit = state_.fixed_[j];
+            if (bit >= 0) {
+                // Exact fixed-bit posterior. Never enters message arithmetic.
+                state_.llrs_[j] = bit ? -std::numeric_limits<double>::infinity()
+                                     : std::numeric_limits<double>::infinity();
+                for (size_t k = graph_->cp[j]; k < graph_->cp[j + 1]; ++k) {
+                    const size_t e = graph_->ce[k];
+                    residual_[graph_->row[e]] ^= uint8_t(bit);
+                    state_.q_[e] = 0;
+                    state_.z_[e] = 0;
+                }
+            }
+            decision_[j] = bit >= 0 ? uint8_t(bit) : uint8_t(state_.llrs_[j] <= 0);
+        }
+        contradiction_ = false;
+        for (int a = 0; a < graph_->m; ++a) {
+            bool has_free = false;
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) has_free |= active(e);
+            contradiction_ |= residual_[a] && !has_free;
+        }
+    }
+    void clear_history() {
+        std::fill(state_.history_.begin(), state_.history_.end(), 0);
+        std::fill(state_.sums_.begin(), state_.sums_.end(), 0);
+        state_.count_ = state_.cursor_ = 0;
+        state_.iterations_ = 0;
+    }
+    void record_history() {
+        const size_t n = size_t(graph_->n), base = state_.cursor_ * n;
+        for (size_t j = 0; j < n; ++j) {
+            const double value = state_.fixed_[j] < 0 ? clip(state_.llrs_[j]) : 0;
+            state_.sums_[j] -= state_.history_[base + j];
+            state_.history_[base + j] = value;
+            state_.sums_[j] += value;
+        }
+        state_.count_ = std::min(state_.count_ + 1, state_.window_);
+        state_.cursor_ = (state_.cursor_ + 1) % state_.window_;
+    }
+    void iteration() {
+        // Parallel checks: all read the previous variable-to-check array.
+        // Zero signs and the degree-one DBL_MAX sentinel match pinned ldpc BP.
+        for (int a = 0; a < graph_->m; ++a) {
+            double first = std::numeric_limits<double>::max(), second = first;
+            size_t minimum = SIZE_MAX;
+            bool sign = bool(residual_[a]);
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) if (active(e)) {
+                const double magnitude = std::abs(state_.q_[e]);
+                sign ^= state_.q_[e] <= 0;
+                if (magnitude < first) { second = first; first = magnitude; minimum = e; }
+                else if (magnitude < second) second = magnitude;
+            }
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) {
+                if (!active(e)) { state_.z_[e] = 0; continue; }
+                const double magnitude = state_.alpha_ * (e == minimum ? second : first);
+                state_.z_[e] = (sign ^ (state_.q_[e] <= 0)) ? -magnitude : magnitude;
+            }
+        }
+        // Prefix/suffix extrinsics avoid subtracting a saturated posterior.
+        for (int j = 0; j < graph_->n; ++j) if (state_.fixed_[j] < 0) {
+            double sum = graph_->weights[j];
+            for (size_t k = graph_->cp[j]; k < graph_->cp[j + 1]; ++k) {
+                const size_t e = graph_->ce[k];
+                state_.q_[e] = sum;
+                sum = add(sum, state_.z_[e]);
+            }
+            state_.llrs_[j] = sum;
+            decision_[j] = uint8_t(sum <= 0);
+            double suffix = 0;
+            for (size_t k = graph_->cp[j + 1]; k > graph_->cp[j];) {
+                const size_t e = graph_->ce[--k];
+                state_.q_[e] = add(state_.q_[e], suffix);
+                suffix = add(suffix, state_.z_[e]);
+            }
+        }
+        ++state_.iterations_;
+        record_history();
+    }
+public:
+    Session(std::shared_ptr<const Graph> graph, int history_window = 8,
+            double history_clip = 25, double scaling_factor = 1) : graph_(std::move(graph)) {
+        if (!graph_ || history_window < 1 || !std::isfinite(history_clip) || history_clip <= 0 ||
+            history_clip > std::numeric_limits<double>::max() / (2.0 * history_window) ||
+            !std::isfinite(scaling_factor) || scaling_factor <= 0 || scaling_factor > 1)
+            throw std::invalid_argument("positive finite history window/clip and scaling in (0,1] required");
+        const size_t n = size_t(graph_->n), edges = graph_->col.size();
+        const size_t window = size_t(history_window);
+        if (n && window > state_.history_.max_size() / n)
+            throw std::length_error("LLR history shape exceeds vector capacity");
+        state_.model_id_ = graph_->model_id;
+        state_.alpha_ = scaling_factor; state_.clip_ = history_clip; state_.window_ = window;
+        state_.q_.resize(edges); state_.z_.resize(edges);
+        state_.llrs_.resize(n); state_.sums_.resize(n); state_.history_.resize(n * window);
+        state_.fixed_.resize(n); decision_.resize(n);
+        state_.syndrome_.resize(size_t(graph_->m)); residual_.resize(size_t(graph_->m));
+    }
+    // D is the complete pattern. Invalid reset invalidates old state; valid reset
+    // replaces all state/history, even when the caller reuses a shot token.
+    void reset_from_channel(const Bits& syndrome, const Pattern& fixed = {}, uint64_t shot_id = 0) {
+        ready_ = false;
+        hybrid::binary(syndrome, size_t(graph_->m));
+        validate_pattern(fixed, false);
+        state_.syndrome_ = syndrome; state_.shot_id_ = shot_id;
+        std::fill(state_.fixed_.begin(), state_.fixed_.end(), -1);
+        for (auto [j, bit] : fixed) state_.fixed_[j] = int8_t(bit);
+        state_.llrs_ = graph_->weights;
+        for (size_t e = 0; e < state_.q_.size(); ++e) state_.q_[e] = graph_->weights[graph_->col[e]];
+        std::fill(state_.z_.begin(), state_.z_.end(), 0);
+        clear_history(); reconstruct(); ready_ = true;
+    }
+    Status status() const {
+        require_ready();
+        if (contradiction_) return Status::LocalContradiction;
+        return graph_->valid(decision_, state_.syndrome_) ? Status::Converged : Status::Ready;
+    }
+    Advance continue_iterations(int64_t requested) {
+        require_ready();
+        if (requested < 0 || uint64_t(requested) > UINT64_MAX - state_.iterations_)
+            throw std::invalid_argument("invalid/overflowing iteration budget");
+        Advance out; out.requested_iterations = uint64_t(requested); out.status = status();
+        while (out.actual_iterations < out.requested_iterations && out.status == Status::Ready) {
+            iteration(); ++out.actual_iterations; out.status = status();
+        }
+        if (out.status == Status::Ready) out.status = Status::BudgetExhausted;
+        out.total_iterations = state_.iterations_;
+        return out;
+    }
+    Snapshot snapshot() const { require_ready(); return state_; }
+    // Restore only within an explicitly reset matching model/shot/syndrome and
+    // numeric policy. Opaque snapshots cannot contain caller-edited buffers.
+    void restore(const Snapshot& source) {
+        require_ready();
+        if (source.model_id_ != state_.model_id_ || source.shot_id_ != state_.shot_id_ ||
+            source.syndrome_ != state_.syndrome_ || source.alpha_ != state_.alpha_ ||
+            source.clip_ != state_.clip_ || source.window_ != state_.window_)
+            throw std::invalid_argument("snapshot model, shot, syndrome or numerical policy mismatch");
+        state_ = source;
+        reconstruct();
+    }
+    // Additional pattern must be nonempty and disjoint from ancestor fixations.
+    // Preserve free q/LLRs; clear history because this is a new masked instance.
+    // Failure leaves this session invalid, requiring reset before reuse.
+    void inherit_descendant(const Snapshot& source, const Pattern& additional) {
+        try {
+            restore(source);
+            validate_pattern(additional, true);
+            for (auto [j, bit] : additional) state_.fixed_[j] = int8_t(bit);
+            clear_history(); reconstruct();
+        } catch (...) { ready_ = false; throw; }
+    }
+    const Bits& decision() const { require_ready(); return decision_; }
+    const Reals& posterior_llr() const { require_ready(); return state_.llrs_; }
+    const Reals& check_to_variable() const { require_ready(); return state_.z_; }
+    const Bits& residual_syndrome() const { require_ready(); return residual_; }
+    const std::vector<int8_t>& fixed() const { require_ready(); return state_.fixed_; }
+    uint64_t total_iterations() const { require_ready(); return state_.iterations_; }
+    size_t history_count() const { require_ready(); return state_.count_; }
+    size_t snapshot_payload_bytes() const { return state_.payload_bytes(); }
+    // Copy at the public boundary, never inside the iteration loop. Short history
+    // averages only completed samples; count==0 returns clipped current LLRs.
+    // Fixed entries are +/-clip placeholders; consumers must use the fixed mask.
+    Reals clipped_mean_llr() const {
+        require_ready();
+        Reals out(size_t(graph_->n));
+        for (size_t j = 0; j < out.size(); ++j)
+            out[j] = state_.fixed_[j] >= 0 || !state_.count_ ? clip(state_.llrs_[j])
+                : state_.sums_[j] / double(state_.count_);
+        return out;
+    }
+};
+}
+#endif
diff --git a/src_cpp/hybrid_graph.hpp b/src_cpp/hybrid_graph.hpp
new file mode 100644
index 0000000..09f51ef
--- /dev/null
+++ b/src_cpp/hybrid_graph.hpp
@@ -0,0 +1,84 @@
+#ifndef LDPC_HYBRID_GRAPH_HPP
+#define LDPC_HYBRID_GRAPH_HPP
+#include "bp.hpp"
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <stdexcept>
+
+namespace ldpc::hybrid {
+using Bits = std::vector<uint8_t>;
+using Reals = std::vector<double>;
+using Rows = std::vector<std::vector<int>>;
+
+inline void binary(const Bits& v, size_t size) {
+    if (v.size()!=size || std::any_of(v.begin(),v.end(),[](uint8_t x){return x>1;}))
+        throw std::invalid_argument("expected binary vector with matching shape");
+}
+inline double finite(double x) {
+    if (!std::isfinite(x)) throw std::overflow_error("nonfinite hybrid arithmetic");
+    return x==0 ? 0.0 : x;
+}
+
+// Owned immutable-by-interface model. Flattened canonical edges are derived from
+// ldpc's graph infrastructure. No input buffer is borrowed. Sizes fit its int API.
+struct Graph {
+    int m,n;
+    uint64_t model_id=14695981039346656037ULL;
+    std::vector<size_t> rp,cp;
+    std::vector<int> col,row;
+    std::vector<size_t> ce;
+    Reals probabilities,weights;
+    Graph(const Rows& rows, int columns, const Reals& p):m(0),n(columns),probabilities(p) {
+        if(n<0 || rows.size()>INT_MAX || p.size()!=size_t(n))
+            throw std::invalid_argument("invalid graph dimensions or prior shape");
+        m=int(rows.size());
+        size_t edges=0;
+        for(const auto& r:rows) {
+            if(!std::is_sorted(r.begin(),r.end()) || std::adjacent_find(r.begin(),r.end())!=r.end())
+                throw std::invalid_argument("rows must contain unique sorted indices");
+            for(int i:r) if(i<0 || i>=n) throw std::invalid_argument("column outside graph");
+            if(r.size()>size_t(INT_MAX)-edges) throw std::length_error("graph exceeds ldpc edge capacity");
+            edges+=r.size();
+        }
+        for(double x:p) {
+            if(!std::isfinite(x)||x<=0||x>.5) throw std::invalid_argument("priors must be finite in (0,0.5]");
+            weights.push_back(finite(std::log1p(-x)-std::log(x)));
+        }
+        auto mix=[this](uint64_t value) {
+            for(int k=0;k<8;++k) {model_id^=(value>>(8*k))&255;model_id*=1099511628211ULL;}
+        };
+        mix(uint64_t(m));mix(uint64_t(n));
+        for(const auto& r:rows) {mix(r.size());for(int i:r) mix(uint64_t(i));}
+        for(double x:p) {uint64_t bits=0;static_assert(sizeof bits==sizeof x);std::memcpy(&bits,&x,sizeof bits);mix(bits);}
+        rp.push_back(0); cp.assign(size_t(n)+1,0);
+        // Empty dimensions are handled algebraically, avoiding upstream allocation assumptions.
+        if(m && n) {
+            ldpc::bp::BpSparse pcm(m,n,int(edges));
+            for(int a=0;a<m;++a) for(int i:rows[a]) pcm.insert_entry(a,i);
+            for(int a=0;a<m;++a) {
+                for(auto& e:pcm.iterate_row(a)) { col.push_back(e.col_index); row.push_back(a); ++cp[e.col_index+1]; }
+                rp.push_back(col.size());
+            }
+        } else rp.resize(size_t(m)+1,0);
+        for(int i=0;i<n;++i) cp[i+1]+=cp[i];
+        ce.resize(edges); auto next=cp;
+        for(size_t e=0;e<col.size();++e) ce[next[col[e]]++]=e;
+    }
+    bool valid(const Bits& e,const Bits& s) const {
+        binary(e,n); binary(s,m);
+        for(int a=0;a<m;++a) { uint8_t x=0; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; if(x!=s[a]) return false; }
+        return true;
+    }
+    uint64_t residual_weight(const Bits& e,const Bits& s) const {
+        uint64_t count=0;
+        for(int a=0;a<m;++a) { uint8_t x=s[a]; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; count+=x; }
+        return count;
+    }
+    bool inconsistent_empty_row(const Bits& s) const {
+        for(int a=0;a<m;++a) if(s[a] && rp[a]==rp[a+1]) return true;
+        return false;
+    }
+};
+}
+#endif
diff --git a/src_cpp/osd0_bridge.hpp b/src_cpp/osd0_bridge.hpp
new file mode 100644
index 0000000..b37a583
--- /dev/null
+++ b/src_cpp/osd0_bridge.hpp
@@ -0,0 +1,37 @@
+#ifndef LDPC_OSD0_BRIDGE_HPP
+#define LDPC_OSD0_BRIDGE_HPP
+#include "hybrid_graph.hpp"
+#include "osd.hpp"
+
+namespace ldpc::hybrid {
+struct OsdResult { Bits correction; bool valid=false; };
+// Own all vectors referenced by upstream OsdDecoder, in destruction-safe order.
+// Non-reentrant. No BP object or higher-order candidates exist on this path.
+class Osd0Bridge {
+    std::shared_ptr<const Graph> graph_;
+    Reals probabilities_;
+    std::unique_ptr<ldpc::bp::BpSparse> pcm_;
+    std::unique_ptr<ldpc::osd::OsdDecoder> osd_;
+public:
+    explicit Osd0Bridge(std::shared_ptr<const Graph> graph):graph_(std::move(graph)) {
+        if(!graph_) throw std::invalid_argument("graph required");
+        probabilities_=graph_->probabilities;
+        if(graph_->m && graph_->n) {
+            pcm_=std::make_unique<ldpc::bp::BpSparse>(graph_->m,graph_->n,int(graph_->col.size()));
+            for(size_t e=0;e<graph_->col.size();++e) pcm_->insert_entry(graph_->row[e],graph_->col[e]);
+            osd_=std::make_unique<ldpc::osd::OsdDecoder>(*pcm_,ldpc::osd::COMBINATION_SWEEP,0,probabilities_);
+        }
+    }
+    OsdResult decode(const Bits& syndrome,const Reals& llrs) {
+        binary(syndrome,graph_->m);
+        if(llrs.size()!=size_t(graph_->n)||std::any_of(llrs.begin(),llrs.end(),[](double x){return !std::isfinite(x);}))
+            throw std::invalid_argument("OSD LLRs must be finite with shape (n,)");
+        OsdResult out; out.correction.assign(graph_->n,0);
+        if(osd_) {auto s=syndrome; auto l=llrs; out.correction=osd_->decode(s,l);}
+        out.valid=graph_->valid(out.correction,syndrome);
+        return out;
+    }
+    size_t candidate_count() const {return osd_ ? osd_->osd_candidate_strings.size() : 0;}
+};
+}
+#endif
diff --git a/src_cpp/reference_bp.hpp b/src_cpp/reference_bp.hpp
new file mode 100644
index 0000000..a98fec6
--- /dev/null
+++ b/src_cpp/reference_bp.hpp
@@ -0,0 +1,214 @@
+#ifndef LDPC_REFERENCE_BP_HPP
+#define LDPC_REFERENCE_BP_HPP
+// Opt-in reference flooding sum-product profile. Ordinary ldpc BP is unchanged.
+// Owns graph and priors. decode() is const with per-call buffers: concurrent calls
+// are safe, provided callers do not modify their arguments during a call.
+// Every returned vector owns its memory; no borrowed buffers survive the call.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ldpc::reference {
+static_assert(sizeof(double) == 8 && std::numeric_limits<double>::is_iec559 &&
+              std::numeric_limits<double>::digits == 53, "reference BP requires IEEE binary64");
+using Bits = std::vector<int>;
+using Beliefs = std::vector<double>;
+
+enum class Status { CONVERGED, NONCONVERGENCE, LOCAL_CONTRADICTION };
+
+struct Trace {
+    Beliefs beliefs;                  // ascending free-variable IDs
+    Beliefs variable_to_check;        // active edges ordered by (check, variable)
+    Beliefs check_to_variable;
+    Bits decision;                    // complete original vector, fixed bits restored
+};
+
+struct Result {
+    Status status = Status::NONCONVERGENCE;
+    int iterations = 0;               // completed flooding iterations, excludes initialization
+    Bits last_decision;               // not a valid correction unless status is CONVERGED
+    Bits free_ids;
+    Beliefs beliefs;
+    std::vector<Beliefs> history;      // oldest to newest, completed iterations only
+    Beliefs mean_llr;
+    Beliefs reliability;              // abs(mean), not mean(abs)
+    Bits flips;                       // L<0 transitions within retained window only
+    std::vector<Trace> trace;          // optional; includes iteration zero
+};
+
+class ReferenceBp {
+    int n_;
+    std::vector<Bits> rows_;
+    Beliefs weights_;
+
+    static double clip(double v, double limit) {
+        return std::max(-limit, std::min(limit, v));
+    }
+
+public:
+    // rows must be canonical strictly ascending original column IDs; empty rows
+    // and isolated variables are allowed. Priors are finite and in (0, 1/2].
+    ReferenceBp(std::vector<Bits> rows, int n, const Beliefs &probabilities)
+        : n_(n), rows_(std::move(rows)) {
+        if (n < 0 || probabilities.size() != static_cast<std::size_t>(n))
+            throw std::invalid_argument("prior length must equal nonnegative n");
+        if (rows_.size() > static_cast<std::size_t>(std::numeric_limits<int>::max()))
+            throw std::invalid_argument("too many checks");
+        for (const auto &row : rows_) {
+            int previous = -1;
+            for (int i : row) {
+                if (i < 0 || i >= n || i <= previous)
+                    throw std::invalid_argument("rows require sorted unique in-range column IDs");
+                previous = i;
+            }
+        }
+        for (double p : probabilities) {
+            if (!std::isfinite(p) || p <= 0 || p > 0.5)
+                throw std::invalid_argument("priors must be finite in (0,0.5]");
+            weights_.push_back(std::log1p(-p) - std::log(p));
+        }
+    }
+
+    const Beliefs &physical_weights() const { return weights_; }
+    int num_variables() const { return n_; }
+    int num_checks() const { return static_cast<int>(rows_.size()); }
+
+    // Fixed is empty (all free) or n entries: -1 free, 0/1 structurally fixed.
+    // Both fixed values remove edges; fixed ones XOR the residual syndrome.
+    // max_iterations >=1, history_window >=0, 0<llr_max<=30. Cold-start every call.
+    // Results contain beliefs/history only for free_ids; fixed bits have no LLR.
+    Result decode(const Bits &syndrome, int max_iterations = 30,
+                  double llr_max = 25, int history_window = 8,
+                  const Bits &fixed = {}, bool diagnostics = false) const {
+        const int m = num_checks();
+        if (syndrome.size() != rows_.size() || max_iterations < 1 || history_window < 0 ||
+            !std::isfinite(llr_max) || llr_max <= 0 || llr_max > 30)
+            throw std::invalid_argument("invalid syndrome shape or BP numerical settings");
+        for (int bit : syndrome)
+            if (bit != 0 && bit != 1) throw std::invalid_argument("syndrome must be binary");
+        if (!fixed.empty() && fixed.size() != static_cast<std::size_t>(n_))
+            throw std::invalid_argument("fixed mask must have length n");
+        Bits mask = fixed.empty() ? Bits(n_, -1) : fixed;
+        for (int bit : mask)
+            if (bit < -1 || bit > 1) throw std::invalid_argument("fixed values must be -1,0,1");
+        Bits residual = syndrome;
+        Result result;
+        result.last_decision.assign(n_, 0);
+        Bits original_to_free(n_, -1);
+        for (int i = 0; i < n_; ++i) {
+            if (mask[i] < 0) {
+                original_to_free[i] = static_cast<int>(result.free_ids.size());
+                result.free_ids.push_back(i);
+            } else {
+                result.last_decision[i] = mask[i];
+            }
+        }
+        // Edge construction preserves ascending original variable and check order.
+        std::vector<Bits> row_edges(m), column_edges(result.free_ids.size());
+        Bits edge_free;
+        for (int a = 0; a < m; ++a) {
+            for (int i : rows_[a]) {
+                if (mask[i] >= 0) {
+                    residual[a] ^= mask[i];
+                    continue;
+                }
+                if (edge_free.size() >= static_cast<std::size_t>(std::numeric_limits<int>::max()))
+                    throw std::invalid_argument("too many active edges");
+                const int edge = static_cast<int>(edge_free.size());
+                const int free = original_to_free[i];
+                edge_free.push_back(free);
+                row_edges[a].push_back(edge);
+                column_edges[free].push_back(edge);
+            }
+        }
+        Beliefs prior;
+        for (int i : result.free_ids) prior.push_back(clip(weights_[i], llr_max));
+        result.beliefs = prior;
+        Beliefs v_old(edge_free.size()), v_new(edge_free.size()), c_new(edge_free.size(), 0);
+        for (std::size_t edge = 0; edge < edge_free.size(); ++edge) v_old[edge] = prior[edge_free[edge]];
+        if (diagnostics) result.trace.push_back({result.beliefs, v_old, c_new, result.last_decision});
+        for (int a = 0; a < m; ++a) {
+            if (row_edges[a].empty() && residual[a]) {
+                result.status = Status::LOCAL_CONTRADICTION;
+                return result;
+            }
+        }
+        auto valid = [&]() {
+            for (int a = 0; a < m; ++a) {
+                int parity = 0;
+                for (int i : rows_[a]) parity ^= result.last_decision[i];
+                if (parity != syndrome[a]) return false;
+            }
+            return true;
+        };
+        if (valid()) {
+            result.status = Status::CONVERGED;
+            return result;
+        }
+        std::deque<Beliefs> history;
+        const double z_max = std::tanh(llr_max / 2);
+        for (int t = 1; t <= max_iterations; ++t) {
+            // Complete check half-step reads only the previous v buffer.
+            for (int a = 0; a < m; ++a) {
+                const auto &edges = row_edges[a];
+                for (int edge : edges) {
+                    if (edges.size() == 1) {
+                        c_new[edge] = residual[a] ? -llr_max : llr_max;
+                    } else {
+                        double z = residual[a] ? -1.0 : 1.0;
+                        for (int other : edges)
+                            if (other != edge) z *= std::tanh(v_old[other] / 2);
+                        z = clip(z, z_max);
+                        c_new[edge] = clip(2 * std::atanh(z), llr_max);
+                    }
+                }
+            }
+            // Completed c buffer is the only message source for this half-step.
+            for (std::size_t free = 0; free < prior.size(); ++free) {
+                double total = 0;
+                for (int edge : column_edges[free]) total += c_new[edge];
+                result.beliefs[free] = clip(prior[free] + total, llr_max);
+                result.last_decision[result.free_ids[free]] = result.beliefs[free] < 0 ? 1 : 0;
+                for (int edge : column_edges[free]) {
+                    double extrinsic = 0;
+                    for (int other : column_edges[free])
+                        if (other != edge) extrinsic += c_new[other];
+                    v_new[edge] = clip(prior[free] + extrinsic, llr_max);
+                }
+            }
+            result.iterations = t;
+            if (history_window > 0) {
+                if (history.size() == static_cast<std::size_t>(history_window)) history.pop_front();
+                history.push_back(result.beliefs);
+            }
+            if (diagnostics) result.trace.push_back({result.beliefs, v_new, c_new, result.last_decision});
+            if (valid()) {
+                result.status = Status::CONVERGED;
+                break;
+            }
+            v_old.swap(v_new);
+        }
+        result.history.assign(history.begin(), history.end());
+        if (!history.empty()) {
+            result.mean_llr.assign(prior.size(), 0);
+            result.flips.assign(prior.size(), 0);
+            result.reliability.resize(prior.size());
+            for (std::size_t free = 0; free < prior.size(); ++free) {
+                for (std::size_t t = 0; t < history.size(); ++t) {
+                    result.mean_llr[free] += history[t][free];
+                    if (t > 0 && (history[t][free] < 0) != (history[t-1][free] < 0)) ++result.flips[free];
+                }
+                result.mean_llr[free] /= static_cast<double>(history.size());
+                result.reliability[free] = std::abs(result.mean_llr[free]);
+            }
+        }
+        return result;
+    }
+};
+} // namespace ldpc::reference
+#endif
diff --git a/src_cpp/stateful_min_sum.hpp b/src_cpp/stateful_min_sum.hpp
new file mode 100644
index 0000000..0d9425e
--- /dev/null
+++ b/src_cpp/stateful_min_sum.hpp
@@ -0,0 +1,134 @@
+#ifndef LDPC_STATEFUL_MIN_SUM_HPP
+#define LDPC_STATEFUL_MIN_SUM_HPP
+#include "hybrid_graph.hpp"
+#include <functional>
+
+namespace ldpc::hybrid {
+struct Snapshot {
+    Reals fields,sums,llrs,q,z;
+    Bits decision,syndrome;
+    uint64_t iterations=0,model_id=0,shot_id=0,numeric_id=0;
+};
+struct Advance { bool valid=false,cap_hit=false; uint64_t iterations=0; };
+
+// Mutable non-reentrant session; owned edge state, shared immutable graph.
+// reset(s[m]) invalidates previous state, including when input validation fails.
+// Fields/LLRs have n entries; q/z use row-major canonical edge IDs. Snapshot copies.
+class StatefulMinSumSession {
+    std::shared_ptr<const Graph> graph_;
+    double limit_,alpha_;
+    Bits syndrome_;
+    uint64_t shot_id_=0,numeric_id_=14695981039346656037ULL;
+    bool ready_=false,fields_ready_=false;
+    Snapshot state_;
+    double clip(double x) const { x=finite(x); return x==0 ? 0.0 : std::max(-limit_,std::min(limit_,x)); }
+    void variables() {
+        const auto& g=*graph_;
+        for(int i=0;i<g.n;++i) {
+            double sum=state_.fields[i];
+            for(size_t j=g.cp[i];j<g.cp[i+1];++j) sum=finite(sum+state_.z[g.ce[j]]);
+            state_.sums[i]=sum; state_.llrs[i]=clip(sum); state_.decision[i]=state_.llrs[i]<=0;
+            for(size_t j=g.cp[i];j<g.cp[i+1];++j) {size_t e=g.ce[j]; state_.q[e]=clip(finite(sum-state_.z[e]));}
+        }
+    }
+public:
+    StatefulMinSumSession(std::shared_ptr<const Graph> graph,double limit=25,double alpha=1):
+        graph_(std::move(graph)),limit_(limit),alpha_(alpha) {
+        if(!graph_ || !std::isfinite(limit)||limit<=0||!std::isfinite(alpha)||alpha<=0||alpha>1)
+            throw std::invalid_argument("finite positive clip and scaling in (0,1] required");
+        auto n=graph_->n; auto edges=graph_->col.size();
+        state_.fields.resize(n); state_.sums.resize(n); state_.llrs.resize(n); state_.decision.resize(n);
+        state_.q.resize(edges); state_.z.resize(edges); state_.iterations=0;
+        auto mix=[this](double x) {uint64_t bits=0;std::memcpy(&bits,&x,sizeof bits);
+            for(int k=0;k<8;++k) {numeric_id_^=(bits>>(8*k))&255;numeric_id_*=1099511628211ULL;}};
+        mix(limit_);mix(alpha_);
+    }
+    void reset(const Bits& s,uint64_t shot_id=0) {
+        ready_=fields_ready_=false; state_.iterations=0;
+        std::fill(state_.q.begin(),state_.q.end(),0); std::fill(state_.z.begin(),state_.z.end(),0);
+        binary(s,graph_->m); syndrome_=s;shot_id_=shot_id; ready_=true;
+    }
+    bool replace_fields(const Reals& fields) {
+        if(!ready_) throw std::logic_error("reset required before fields");
+        fields_ready_=false;
+        if(fields.size()!=size_t(graph_->n)||std::any_of(fields.begin(),fields.end(),[](double x){return !std::isfinite(x);})) {
+            ready_=false; throw std::invalid_argument("fields must be finite with shape (n,)");
+        }
+        try { state_.fields=fields; variables(); fields_ready_=true; return valid(); }
+        catch(...) { ready_=false; throw; }
+    }
+    bool replace_hint(const std::vector<std::pair<int,uint8_t>>& pattern,double margin) {
+        try {
+        if(!std::isfinite(margin)||margin<=0) {ready_=false; throw std::invalid_argument("hint margin must be finite and positive");}
+        auto fields=graph_->weights;
+        int previous=-1;
+        for(auto [i,b]:pattern) {
+            if(i<=previous||i>=graph_->n||b>1) {ready_=false; throw std::invalid_argument("hint must be sorted unique in-range binary assignments");}
+            previous=i; fields[i]=finite((b ? -1.0 : 1.0)*finite(fields[i]+margin));
+        }
+        return replace_fields(fields);
+        } catch(...) {ready_=fields_ready_=false;throw;}
+    }
+    bool valid() const { return ready_ && fields_ready_ && graph_->valid(state_.decision,syndrome_); }
+    Advance advance(int count,const std::function<bool()>& cap={}) {
+        if(count<0) throw std::invalid_argument("iteration count must be nonnegative");
+        if(!ready_||!fields_ready_) throw std::logic_error("reset and fields required before iterations");
+        Advance out; out.valid=valid();
+        try {
+            for(int t=0;t<count && !out.valid;++t) {
+                if(cap && cap()) {out.cap_hit=true; break;}
+                const auto& g=*graph_;
+                // All checks read the old q; q is written only after this pass.
+                for(int a=0;a<g.m;++a) {
+                    auto begin=g.rp[a],end=g.rp[a+1];
+                    if(begin==end) continue;
+                    if(end-begin==1) {state_.z[begin]=syndrome_[a] ? -limit_ : limit_; continue;}
+                    double first=std::numeric_limits<double>::infinity(),second=first;
+                    bool sign=bool(syndrome_[a]); size_t min_edge=begin;
+                    for(size_t e=begin;e<end;++e) {
+                        double x=state_.q[e],v=std::abs(x); sign^=x<0;
+                        if(v<first) {second=first; first=v; min_edge=e;} else if(v<second) second=v;
+                    }
+                    for(size_t e=begin;e<end;++e) {
+                        double magnitude=alpha_*(e==min_edge ? second : first);
+                        state_.z[e]=clip((sign^(state_.q[e]<0)) ? -magnitude : magnitude);
+                    }
+                }
+                variables(); ++state_.iterations; ++out.iterations; out.valid=valid();
+            }
+        } catch(...) { ready_=fields_ready_=false; throw; }
+        return out;
+    }
+    uint64_t completed_iterations() const {return state_.iterations;} // completed full iterations, even after an exception
+    Snapshot snapshot() const {
+        if(!ready_||!fields_ready_) throw std::logic_error("no active BP state");
+        Snapshot out=state_;out.syndrome=syndrome_;out.model_id=graph_->model_id;
+        out.shot_id=shot_id_;out.numeric_id=numeric_id_;return out;
+    }
+    void restore(const Snapshot& source,uint64_t shot_id) {
+        if(!ready_||syndrome_!=source.syndrome||shot_id_!=shot_id)
+            throw std::invalid_argument("reset with the matching syndrome and shot before restore");
+        fields_ready_=false;
+        if(source.model_id!=graph_->model_id||source.numeric_id!=numeric_id_||source.shot_id!=shot_id)
+            throw std::invalid_argument("snapshot model, numeric policy, or shot identity mismatch");
+        binary(source.syndrome,graph_->m);binary(source.decision,graph_->n);
+        const size_t edges=graph_->col.size(),columns=size_t(graph_->n);
+        if(source.fields.size()!=columns||source.sums.size()!=columns||source.llrs.size()!=columns||
+           source.q.size()!=edges||source.z.size()!=edges)
+            throw std::invalid_argument("snapshot buffer shape mismatch");
+        auto valid_reals=[](const Reals& values) {return std::none_of(values.begin(),values.end(),[](double x){return !std::isfinite(x);});};
+        if(!valid_reals(source.fields)||!valid_reals(source.sums)||!valid_reals(source.llrs)||
+           !valid_reals(source.q)||!valid_reals(source.z))
+            throw std::invalid_argument("snapshot contains nonfinite values");
+        state_=source;syndrome_=source.syndrome;shot_id_=shot_id;ready_=fields_ready_=true;
+    }
+    size_t snapshot_bytes() const {
+        return 5*size_t(graph_->n)*sizeof(double)+2*graph_->col.size()*sizeof(double)+
+               size_t(graph_->n)*sizeof(uint8_t)+size_t(graph_->m)*sizeof(uint8_t)+5*sizeof(uint64_t);
+    }
+    const Reals& llrs() const {return state_.llrs;}
+    const Bits& decision() const {return state_.decision;}
+    const Bits& syndrome() const {return syndrome_;}
+};
+}
+#endif
