@@ -0,0 +1,17 @@
+"""Exact source set for the independent AF-BP BP engine."""
+from pathlib import Path
+import hashlib
+
+SOURCE_FILES = (
+    "src_cpp/af_bp.hpp", "src_python/ldpc/af_bp/bindings.cpp",
+    "src_python/ldpc/af_bp/__init__.py", "src_python/ldpc/af_bp/__init__.pyi",
+    "src_python/ldpc/af_bp/source_files.py", "src_python/ldpc/af_bp/README.md",
+    "setup_af_bp.py",
+)
+
+
+def source_digest(root: Path) -> str:
+    digest = hashlib.sha256()
+    for name in SOURCE_FILES:
+        digest.update(name.encode() + b"\0" + (root / name).read_bytes())
+    return digest.hexdigest()
