@@ -0,0 +1,11 @@
+"""Opt-in flooding BP. Build with python setup_reference.py build_ext --inplace.
+
+ReferenceBp owns canonical graph/prior copies. Its const decode method cold-starts
+on each call, releases the GIL and supports concurrent calls. Returned native
+results own all buffers; Python property accesses return copies. The native sparse
+constructor takes rows as sorted unique column IDs, n, and length-n probabilities.
+Both fixed zero and fixed one remove edges. Beliefs/history use free_ids order;
+last_decision is full length and is a valid correction only with CONVERGED status.
+"""
+from ._reference_bp import ReferenceBp, Result, Status, Trace, build_identity
+__all__ = ["ReferenceBp", "Result", "Status", "Trace", "build_identity"]
