+++ b/src_cpp/README.reference_bp.md
@@ -0,0 +1,10 @@
+# Opt-in reference_bp.hpp addition
+
+ReferenceBp owns sorted graph/prior copies and has a const decode API. Per-call
+active adjacency removes fixed zeros and ones; original IDs are retained. Two
+message buffers enforce flooding barriers. Returned Result/Trace objects own their
+vectors and have no borrowed lifetimes. Concurrent calls do not share mutable state.
+
+This addition does not modify bp.hpp or ordinary BP-OSD. The benchmark's
+README under the Python reference_bp binding and docs/reference_bp.md describe
+numerics, shapes, test evidence and the explicit build. No search code lives here.
diff --git a/src_cpp/decimated_bp.hpp b/src_cpp/decimated_bp.hpp
new file mode 100644
index 0000000..b1242cc
--- /dev/null
+++ b/src_cpp/decimated_bp.hpp
@@ -0,0 +1,257 @@
+#ifndef LDPC_DECIMATED_BP_HPP
+#define LDPC_DECIMATED_BP_HPP
+
+#include "hybrid_graph.hpp"
+#include <limits>
+#include <memory>
+
+namespace ldpc::decimated {
+using hybrid::Bits;
+using hybrid::Graph;
+using hybrid::Reals;
+using Pattern = std::vector<std::pair<int, int>>;
+
+enum class Status { Ready, Converged, LocalContradiction, BudgetExhausted };
+struct Advance {
+    uint64_t requested_iterations = 0, actual_iterations = 0, total_iterations = 0;
+    Status status = Status::Ready;
+    bool valid() const { return status == Status::Converged; }
+};
+
+// Immutable-by-interface owned snapshot. z, decision, residual and mean are
+// derived/work buffers and are deliberately not copied. No graph is copied.
+class Snapshot {
+    friend class Session;
+    Reals q_, llrs_, history_, sums_;
+    std::vector<int8_t> fixed_;
+    Bits syndrome_;
+    uint64_t model_id_ = 0, shot_id_ = 0, iterations_ = 0;
+    size_t window_ = 0, count_ = 0, cursor_ = 0;
+    double alpha_ = 1, clip_ = 25;
+    Snapshot() = default;
+public:
+    Snapshot(const Snapshot&) = default;
+    Snapshot(Snapshot&&) noexcept = default;
+    Snapshot& operator=(const Snapshot&) = default;
+    Snapshot& operator=(Snapshot&&) noexcept = default;
+    const Reals& q() const { return q_; }
+    const Reals& llrs() const { return llrs_; }
+    const std::vector<int8_t>& fixed() const { return fixed_; }
+    const Bits& syndrome() const { return syndrome_; }
+    uint64_t shot_id() const { return shot_id_; }
+    uint64_t iterations() const { return iterations_; }
+    size_t history_count() const { return count_; }
+    size_t history_window() const { return window_; }
+    // Vector payload only: excludes vector/control objects, capacities and allocator overhead.
+    size_t payload_bytes() const {
+        return sizeof(double) * (q_.size() + llrs_.size() + history_.size() + sums_.size())
+            + sizeof(int8_t) * fixed_.size() + sizeof(uint8_t) * syndrome_.size();
+    }
+};
+
+// Non-reentrant, worker-owned session, sharing an immutable graph. All arrays
+// allocate at construction; iterations/reset/inheritance reuse their capacities.
+// Native const array views last only until the next mutation; snapshots own copies.
+class Session {
+    std::shared_ptr<const Graph> graph_;
+    Snapshot state_;
+    Reals z_;                       // overwritten before use on each iteration
+    Bits decision_, residual_;
+    bool ready_ = false, contradiction_ = false;
+
+    void require_ready() const {
+        if (!ready_) throw std::logic_error("reset_from_channel required before BP access");
+    }
+    bool active(size_t edge) const { return state_.fixed_[graph_->col[edge]] < 0; }
+    static double add(double a, double b) {
+        constexpr double top = std::numeric_limits<double>::max();
+        if (b > 0 && a > top - b) return top;
+        if (b < 0 && a < -top - b) return -top;
+        return a + b;
+    }
+    double clip(double x) const { return std::max(-state_.clip_, std::min(state_.clip_, x)); }
+    void validate_pattern(const Pattern& pattern, bool additional) const {
+        int previous = -1;
+        if (additional && pattern.empty()) throw std::invalid_argument("descendant requires additional fixations");
+        for (auto [j, bit] : pattern) {
+            if (j <= previous || j < 0 || j >= graph_->n || (bit != 0 && bit != 1))
+                throw std::invalid_argument("fixations must be sorted unique in-range binary assignments");
+            if (additional && state_.fixed_[j] >= 0)
+                throw std::invalid_argument("additional fixation overlaps an ancestor fixation");
+            previous = j;
+        }
+    }
+    void reconstruct() {
+        residual_ = state_.syndrome_;
+        for (int j = 0; j < graph_->n; ++j) {
+            const int bit = state_.fixed_[j];
+            if (bit >= 0) {
+                // Exact fixed-bit posterior. Never enters message arithmetic.
+                state_.llrs_[j] = bit ? -std::numeric_limits<double>::infinity()
+                                     : std::numeric_limits<double>::infinity();
+                for (size_t k = graph_->cp[j]; k < graph_->cp[j + 1]; ++k) {
+                    const size_t e = graph_->ce[k];
+                    residual_[graph_->row[e]] ^= uint8_t(bit);
+                    state_.q_[e] = 0;
+                    z_[e] = 0;
+                }
+            }
+            decision_[j] = bit >= 0 ? uint8_t(bit) : uint8_t(state_.llrs_[j] <= 0);
+        }
+        contradiction_ = false;
+        for (int a = 0; a < graph_->m; ++a) {
+            bool has_free = false;
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) has_free |= active(e);
+            contradiction_ |= residual_[a] && !has_free;
+        }
+    }
+    void clear_history() {
+        std::fill(state_.history_.begin(), state_.history_.end(), 0);
+        std::fill(state_.sums_.begin(), state_.sums_.end(), 0);
+        state_.count_ = state_.cursor_ = 0;
+        state_.iterations_ = 0;
+    }
+    void record_history() {
+        const size_t n = size_t(graph_->n), base = state_.cursor_ * n;
+        for (size_t j = 0; j < n; ++j) {
+            const double value = state_.fixed_[j] < 0 ? clip(state_.llrs_[j]) : 0;
+            state_.sums_[j] -= state_.history_[base + j];
+            state_.history_[base + j] = value;
+            state_.sums_[j] += value;
+        }
+        state_.count_ = std::min(state_.count_ + 1, state_.window_);
+        state_.cursor_ = (state_.cursor_ + 1) % state_.window_;
+    }
+    void iteration() {
+        // Parallel checks: all read the previous variable-to-check array.
+        // Zero signs and the degree-one DBL_MAX sentinel match pinned ldpc BP.
+        for (int a = 0; a < graph_->m; ++a) {
+            double first = std::numeric_limits<double>::max(), second = first;
+            size_t minimum = SIZE_MAX;
+            bool sign = bool(residual_[a]);
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) if (active(e)) {
+                const double magnitude = std::abs(state_.q_[e]);
+                sign ^= state_.q_[e] <= 0;
+                if (magnitude < first) { second = first; first = magnitude; minimum = e; }
+                else if (magnitude < second) second = magnitude;
+            }
+            for (size_t e = graph_->rp[a]; e < graph_->rp[a + 1]; ++e) {
+                if (!active(e)) { z_[e] = 0; continue; }
+                const double magnitude = state_.alpha_ * (e == minimum ? second : first);
+                z_[e] = (sign ^ (state_.q_[e] <= 0)) ? -magnitude : magnitude;
+            }
+        }
+        // Prefix/suffix extrinsics avoid subtracting a saturated posterior.
+        for (int j = 0; j < graph_->n; ++j) if (state_.fixed_[j] < 0) {
+            double sum = graph_->weights[j];
+            for (size_t k = graph_->cp[j]; k < graph_->cp[j + 1]; ++k) {
+                const size_t e = graph_->ce[k];
+                state_.q_[e] = sum;
+                sum = add(sum, z_[e]);
+            }
+            state_.llrs_[j] = sum;
+            decision_[j] = uint8_t(sum <= 0);
+            double suffix = 0;
+            for (size_t k = graph_->cp[j + 1]; k > graph_->cp[j];) {
+                const size_t e = graph_->ce[--k];
+                state_.q_[e] = add(state_.q_[e], suffix);
+                suffix = add(suffix, z_[e]);
+            }
+        }
+        ++state_.iterations_;
+        record_history();
+    }
+public:
+    Session(std::shared_ptr<const Graph> graph, int history_window = 8,
+            double history_clip = 25, double scaling_factor = 1) : graph_(std::move(graph)) {
+        if (!graph_ || history_window < 1 || !std::isfinite(history_clip) || history_clip <= 0 ||
+            history_clip > std::numeric_limits<double>::max() / (2.0 * history_window) ||
+            !std::isfinite(scaling_factor) || scaling_factor <= 0 || scaling_factor > 1)
+            throw std::invalid_argument("positive finite history window/clip and scaling in (0,1] required");
+        const size_t n = size_t(graph_->n), edges = graph_->col.size();
+        const size_t window = size_t(history_window);
+        if (n && window > state_.history_.max_size() / n)
+            throw std::length_error("LLR history shape exceeds vector capacity");
+        state_.model_id_ = graph_->model_id;
+        state_.alpha_ = scaling_factor; state_.clip_ = history_clip; state_.window_ = window;
+        state_.q_.resize(edges); z_.resize(edges);
+        state_.llrs_.resize(n); state_.sums_.resize(n); state_.history_.resize(n * window);
+        state_.fixed_.resize(n); decision_.resize(n);
+        state_.syndrome_.resize(size_t(graph_->m)); residual_.resize(size_t(graph_->m));
+    }
+    // D is the complete pattern. Invalid reset invalidates old state; valid reset
+    // replaces all state/history, even when the caller reuses a shot token.
+    void reset_from_channel(const Bits& syndrome, const Pattern& fixed = {}, uint64_t shot_id = 0) {
+        ready_ = false;
+        hybrid::binary(syndrome, size_t(graph_->m));
+        validate_pattern(fixed, false);
+        state_.syndrome_ = syndrome; state_.shot_id_ = shot_id;
+        std::fill(state_.fixed_.begin(), state_.fixed_.end(), -1);
+        for (auto [j, bit] : fixed) state_.fixed_[j] = int8_t(bit);
+        state_.llrs_ = graph_->weights;
+        for (size_t e = 0; e < state_.q_.size(); ++e) state_.q_[e] = graph_->weights[graph_->col[e]];
+        std::fill(z_.begin(), z_.end(), 0);
+        clear_history(); reconstruct(); ready_ = true;
+    }
+    Status status() const {
+        require_ready();
+        if (contradiction_) return Status::LocalContradiction;
+        return graph_->valid(decision_, state_.syndrome_) ? Status::Converged : Status::Ready;
+    }
+    Advance continue_iterations(int64_t requested) {
+        require_ready();
+        if (requested < 0 || uint64_t(requested) > UINT64_MAX - state_.iterations_)
+            throw std::invalid_argument("invalid/overflowing iteration budget");
+        Advance out; out.requested_iterations = uint64_t(requested); out.status = status();
+        while (out.actual_iterations < out.requested_iterations && out.status == Status::Ready) {
+            iteration(); ++out.actual_iterations; out.status = status();
+        }
+        if (out.status == Status::Ready) out.status = Status::BudgetExhausted;
+        out.total_iterations = state_.iterations_;
+        return out;
+    }
+    Snapshot snapshot() const { require_ready(); return state_; }
+    // Restore only within an explicitly reset matching model/shot/syndrome and
+    // numeric policy. Opaque snapshots cannot contain caller-edited buffers.
+    void restore(const Snapshot& source) {
+        require_ready();
+        if (source.model_id_ != state_.model_id_ || source.shot_id_ != state_.shot_id_ ||
+            source.syndrome_ != state_.syndrome_ || source.alpha_ != state_.alpha_ ||
+            source.clip_ != state_.clip_ || source.window_ != state_.window_)
+            throw std::invalid_argument("snapshot model, shot, syndrome or numerical policy mismatch");
+        state_ = source;
+        std::fill(z_.begin(), z_.end(), 0);
+        reconstruct();
+    }
+    // Additional pattern must be nonempty and disjoint from ancestor fixations.
+    // Preserve free q/LLRs; clear history because this is a new masked instance.
+    // Failure leaves this session invalid, requiring reset before reuse.
+    void inherit_descendant(const Snapshot& source, const Pattern& additional) {
+        try {
+            restore(source);
+            validate_pattern(additional, true);
+            for (auto [j, bit] : additional) state_.fixed_[j] = int8_t(bit);
+            clear_history(); reconstruct();
+        } catch (...) { ready_ = false; throw; }
+    }
+    const Bits& decision() const { require_ready(); return decision_; }
+    const Reals& posterior_llr() const { require_ready(); return state_.llrs_; }
+    const Bits& residual_syndrome() const { require_ready(); return residual_; }
+    const std::vector<int8_t>& fixed() const { require_ready(); return state_.fixed_; }
+    uint64_t total_iterations() const { require_ready(); return state_.iterations_; }
+    size_t history_count() const { require_ready(); return state_.count_; }
+    size_t snapshot_payload_bytes() const { return state_.payload_bytes(); }
+    // Copy at the public boundary, never inside the iteration loop. Short history
+    // averages only completed samples; count==0 returns clipped current LLRs.
+    // Fixed entries are +/-clip placeholders; consumers must use the fixed mask.
+    Reals clipped_mean_llr() const {
+        require_ready();
+        Reals out(size_t(graph_->n));
+        for (size_t j = 0; j < out.size(); ++j)
+            out[j] = state_.fixed_[j] >= 0 || !state_.count_ ? clip(state_.llrs_[j])
+                : state_.sums_[j] / double(state_.count_);
+        return out;
+    }
+};
+}
+#endif
diff --git a/src_cpp/hybrid_graph.hpp b/src_cpp/hybrid_graph.hpp
new file mode 100644
index 0000000..09f51ef
--- /dev/null
+++ b/src_cpp/hybrid_graph.hpp
@@ -0,0 +1,84 @@
+#ifndef LDPC_HYBRID_GRAPH_HPP
+#define LDPC_HYBRID_GRAPH_HPP
+#include "bp.hpp"
+#include <algorithm>
+#include <climits>
+#include <cstring>
+#include <stdexcept>
+
+namespace ldpc::hybrid {
+using Bits = std::vector<uint8_t>;
+using Reals = std::vector<double>;
+using Rows = std::vector<std::vector<int>>;
+
+inline void binary(const Bits& v, size_t size) {
+    if (v.size()!=size || std::any_of(v.begin(),v.end(),[](uint8_t x){return x>1;}))
+        throw std::invalid_argument("expected binary vector with matching shape");
+}
+inline double finite(double x) {
+    if (!std::isfinite(x)) throw std::overflow_error("nonfinite hybrid arithmetic");
+    return x==0 ? 0.0 : x;
+}
+
+// Owned immutable-by-interface model. Flattened canonical edges are derived from
+// ldpc's graph infrastructure. No input buffer is borrowed. Sizes fit its int API.
+struct Graph {
+    int m,n;
+    uint64_t model_id=14695981039346656037ULL;
+    std::vector<size_t> rp,cp;
+    std::vector<int> col,row;
+    std::vector<size_t> ce;
+    Reals probabilities,weights;
+    Graph(const Rows& rows, int columns, const Reals& p):m(0),n(columns),probabilities(p) {
+        if(n<0 || rows.size()>INT_MAX || p.size()!=size_t(n))
+            throw std::invalid_argument("invalid graph dimensions or prior shape");
+        m=int(rows.size());
+        size_t edges=0;
+        for(const auto& r:rows) {
+            if(!std::is_sorted(r.begin(),r.end()) || std::adjacent_find(r.begin(),r.end())!=r.end())
+                throw std::invalid_argument("rows must contain unique sorted indices");
+            for(int i:r) if(i<0 || i>=n) throw std::invalid_argument("column outside graph");
+            if(r.size()>size_t(INT_MAX)-edges) throw std::length_error("graph exceeds ldpc edge capacity");
+            edges+=r.size();
+        }
+        for(double x:p) {
+            if(!std::isfinite(x)||x<=0||x>.5) throw std::invalid_argument("priors must be finite in (0,0.5]");
+            weights.push_back(finite(std::log1p(-x)-std::log(x)));
+        }
+        auto mix=[this](uint64_t value) {
+            for(int k=0;k<8;++k) {model_id^=(value>>(8*k))&255;model_id*=1099511628211ULL;}
+        };
+        mix(uint64_t(m));mix(uint64_t(n));
+        for(const auto& r:rows) {mix(r.size());for(int i:r) mix(uint64_t(i));}
+        for(double x:p) {uint64_t bits=0;static_assert(sizeof bits==sizeof x);std::memcpy(&bits,&x,sizeof bits);mix(bits);}
+        rp.push_back(0); cp.assign(size_t(n)+1,0);
+        // Empty dimensions are handled algebraically, avoiding upstream allocation assumptions.
+        if(m && n) {
+            ldpc::bp::BpSparse pcm(m,n,int(edges));
+            for(int a=0;a<m;++a) for(int i:rows[a]) pcm.insert_entry(a,i);
+            for(int a=0;a<m;++a) {
+                for(auto& e:pcm.iterate_row(a)) { col.push_back(e.col_index); row.push_back(a); ++cp[e.col_index+1]; }
+                rp.push_back(col.size());
+            }
+        } else rp.resize(size_t(m)+1,0);
+        for(int i=0;i<n;++i) cp[i+1]+=cp[i];
+        ce.resize(edges); auto next=cp;
+        for(size_t e=0;e<col.size();++e) ce[next[col[e]]++]=e;
+    }
+    bool valid(const Bits& e,const Bits& s) const {
+        binary(e,n); binary(s,m);
+        for(int a=0;a<m;++a) { uint8_t x=0; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; if(x!=s[a]) return false; }
+        return true;
+    }
+    uint64_t residual_weight(const Bits& e,const Bits& s) const {
+        uint64_t count=0;
+        for(int a=0;a<m;++a) { uint8_t x=s[a]; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; count+=x; }
+        return count;
+    }
+    bool inconsistent_empty_row(const Bits& s) const {
+        for(int a=0;a<m;++a) if(s[a] && rp[a]==rp[a+1]) return true;
+        return false;
+    }
+};
+}
+#endif
