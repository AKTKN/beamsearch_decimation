new file mode 100644
index 0000000..19fa24c
--- /dev/null
+++ b/src_python/ldpc/reference_bp/bindings.cpp
@@ -0,0 +1,46 @@
+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+#include "reference_bp.hpp"
+namespace py = pybind11;
+using namespace ldpc::reference;
+
+PYBIND11_MODULE(_reference_bp, m) {
+    m.doc() = "Opt-in binary64 reference flooding BP, with structural fixation and native history.";
+    m.def("build_identity", []() {
+        py::dict identity;
+        identity["profile"] = "screened_reference_flooding_v1";
+        identity["upstream_commit"] = REFERENCE_UPSTREAM_COMMIT;
+        identity["source_sha256"] = REFERENCE_SOURCE_HASH;
+        identity["compiler"] = __VERSION__;
+        identity["flags"] = "-O3 -std=c++17 -fno-fast-math -ffp-contract=off";
+        return identity;
+    });
+    py::enum_<Status>(m, "Status")
+        .value("CONVERGED", Status::CONVERGED)
+        .value("NONCONVERGENCE", Status::NONCONVERGENCE)
+        .value("LOCAL_CONTRADICTION", Status::LOCAL_CONTRADICTION);
+    py::class_<Trace>(m, "Trace")
+        .def_readonly("beliefs", &Trace::beliefs)
+        .def_readonly("variable_to_check", &Trace::variable_to_check)
+        .def_readonly("check_to_variable", &Trace::check_to_variable)
+        .def_readonly("decision", &Trace::decision);
+    py::class_<Result>(m, "Result")
+        .def_readonly("status", &Result::status)
+        .def_readonly("iterations", &Result::iterations)
+        .def_readonly("last_decision", &Result::last_decision)
+        .def_readonly("free_ids", &Result::free_ids)
+        .def_readonly("beliefs", &Result::beliefs)
+        .def_readonly("history", &Result::history)
+        .def_readonly("mean_llr", &Result::mean_llr)
+        .def_readonly("reliability", &Result::reliability)
+        .def_readonly("flips", &Result::flips)
+        .def_readonly("trace", &Result::trace);
+    py::class_<ReferenceBp>(m, "ReferenceBp")
+        .def(py::init<std::vector<Bits>, int, const Beliefs&>(), py::arg("rows"), py::arg("n"), py::arg("probabilities"))
+        .def_property_readonly("physical_weights", &ReferenceBp::physical_weights)
+        .def_property_readonly("num_variables", &ReferenceBp::num_variables)
+        .def_property_readonly("num_checks", &ReferenceBp::num_checks)
+        .def("decode", &ReferenceBp::decode, py::arg("syndrome"), py::arg("max_iterations")=30,
+             py::arg("llr_max")=25.0, py::arg("history_window")=8, py::arg("fixed")=Bits{},
+             py::arg("diagnostics")=false, py::call_guard<py::gil_scoped_release>());
+}
