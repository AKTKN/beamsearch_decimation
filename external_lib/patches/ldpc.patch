+#include <pybind11/pybind11.h>
+#include <pybind11/stl.h>
+#include "stateful_min_sum.hpp"
+#include "decimated_bp.hpp"
+#include "osd0_bridge.hpp"
+namespace py=pybind11;
+using namespace ldpc::hybrid;
+PYBIND11_MODULE(_hybrid_bp,m) {
+    m.doc()="Opt-in stateful flooding min-sum and direct pinned CS/order-zero OSD.";
+    m.def("build_identity",[](){py::dict d; d["profile"]="HSBP-ALG-1.0";
+        d["upstream_commit"]=HYBRID_UPSTREAM_COMMIT; d["source_sha256"]=HYBRID_SOURCE_HASH;
+        d["compiler"]=__VERSION__; d["flags"]="-O3 -std=c++17 -fno-fast-math -ffp-contract=off"; return d;});
+    py::class_<Snapshot>(m,"Snapshot")
+        .def_readonly("fields",&Snapshot::fields).def_readonly("sums",&Snapshot::sums)
+        .def_readonly("llrs",&Snapshot::llrs).def_readonly("q",&Snapshot::q).def_readonly("z",&Snapshot::z)
+        .def_readonly("decision",&Snapshot::decision).def_readonly("syndrome",&Snapshot::syndrome)
+        .def_readonly("iterations",&Snapshot::iterations).def_readonly("model_id",&Snapshot::model_id)
+        .def_readonly("shot_id",&Snapshot::shot_id).def_readonly("numeric_id",&Snapshot::numeric_id);
+    py::class_<Advance>(m,"Advance").def_readonly("valid",&Advance::valid)
+        .def_readonly("cap_hit",&Advance::cap_hit).def_readonly("iterations",&Advance::iterations);
+    py::class_<StatefulMinSumSession>(m,"StatefulMinSumSession")
+        .def(py::init([](const Rows& rows,int n,const Reals& p,double clip,double alpha){
