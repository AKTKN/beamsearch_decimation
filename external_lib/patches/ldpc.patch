+PYBIND11_MODULE(_hybrid_bp,m) {
+    m.doc()="Opt-in stateful flooding min-sum and direct pinned CS/order-zero OSD.";
+    m.def("build_identity",[](){py::dict d; d["profile"]="HSBP-ALG-1.0";
+        d["upstream_commit"]=HYBRID_UPSTREAM_COMMIT; d["source_sha256"]=HYBRID_SOURCE_HASH;
+        d["compiler"]=__VERSION__; d["flags"]="-O3 -std=c++17 -fno-fast-math -ffp-contract=off"; return d;});
+    py::class_<Snapshot>(m,"Snapshot")
+        .def_readonly("fields",&Snapshot::fields).def_readonly("sums",&Snapshot::sums)
+        .def_readonly("llrs",&Snapshot::llrs).def_readonly("q",&Snapshot::q).def_readonly("z",&Snapshot::z)
+        .def_readonly("decision",&Snapshot::decision).def_readonly("iterations",&Snapshot::iterations);
+    py::class_<Advance>(m,"Advance").def_readonly("valid",&Advance::valid)
+        .def_readonly("cap_hit",&Advance::cap_hit).def_readonly("iterations",&Advance::iterations);
+    py::class_<StatefulMinSumSession>(m,"StatefulMinSumSession")
+        .def(py::init([](const Rows& rows,int n,const Reals& p,double clip,double alpha){
+            return std::make_unique<StatefulMinSumSession>(std::make_shared<Graph>(rows,n,p),clip,alpha);}),
+            py::arg("rows"),py::arg("n"),py::arg("probabilities"),py::arg("llr_clip")=25.,py::arg("scaling_factor")=1.)
+        .def("reset",&StatefulMinSumSession::reset,py::call_guard<py::gil_scoped_release>())
+        .def("replace_fields",&StatefulMinSumSession::replace_fields,py::call_guard<py::gil_scoped_release>())
+        .def("replace_hint",&StatefulMinSumSession::replace_hint,py::call_guard<py::gil_scoped_release>())
+        .def("advance",[](StatefulMinSumSession& session,int count){return session.advance(count);},py::call_guard<py::gil_scoped_release>())
+        .def("snapshot",&StatefulMinSumSession::snapshot);
+    py::class_<OsdResult>(m,"OsdResult").def_readonly("valid",&OsdResult::valid).def_readonly("correction",&OsdResult::correction);
+    py::class_<Osd0Bridge>(m,"Osd0Bridge")
