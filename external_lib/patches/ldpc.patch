+++ b/src_cpp/README.reference_bp.md
@@ -0,0 +1,10 @@
+# Opt-in reference_bp.hpp addition
+
+ReferenceBp owns sorted graph/prior copies and has a const decode API. Per-call
+active adjacency removes fixed zeros and ones; original IDs are retained. Two
+message buffers enforce flooding barriers. Returned Result/Trace objects own their
+vectors and have no borrowed lifetimes. Concurrent calls do not share mutable state.
+
+This addition does not modify bp.hpp or ordinary BP-OSD. The benchmark's
+README under the Python reference_bp binding and docs/reference_bp.md describe
+numerics, shapes, test evidence and the explicit build. No search code lives here.
diff --git a/src_cpp/hybrid_graph.hpp b/src_cpp/hybrid_graph.hpp
new file mode 100644
index 0000000..c452fd2
--- /dev/null
+++ b/src_cpp/hybrid_graph.hpp
@@ -0,0 +1,76 @@
+#ifndef LDPC_HYBRID_GRAPH_HPP
+#define LDPC_HYBRID_GRAPH_HPP
+#include "bp.hpp"
+#include <algorithm>
+#include <climits>
+#include <stdexcept>
+
+namespace ldpc::hybrid {
+using Bits = std::vector<uint8_t>;
+using Reals = std::vector<double>;
+using Rows = std::vector<std::vector<int>>;
+
+inline void binary(const Bits& v, size_t size) {
+    if (v.size()!=size || std::any_of(v.begin(),v.end(),[](uint8_t x){return x>1;}))
+        throw std::invalid_argument("expected binary vector with matching shape");
+}
+inline double finite(double x) {
+    if (!std::isfinite(x)) throw std::overflow_error("nonfinite hybrid arithmetic");
+    return x==0 ? 0.0 : x;
+}
+
+// Owned immutable-by-interface model. Flattened canonical edges are derived from
+// ldpc's graph infrastructure. No input buffer is borrowed. Sizes fit its int API.
+struct Graph {
+    int m,n;
+    std::vector<size_t> rp,cp;
+    std::vector<int> col,row;
+    std::vector<size_t> ce;
+    Reals probabilities,weights;
+    Graph(const Rows& rows, int columns, const Reals& p):m(0),n(columns),probabilities(p) {
+        if(n<0 || rows.size()>INT_MAX || p.size()!=size_t(n))
+            throw std::invalid_argument("invalid graph dimensions or prior shape");
+        m=int(rows.size());
+        size_t edges=0;
+        for(const auto& r:rows) {
+            if(!std::is_sorted(r.begin(),r.end()) || std::adjacent_find(r.begin(),r.end())!=r.end())
+                throw std::invalid_argument("rows must contain unique sorted indices");
+            for(int i:r) if(i<0 || i>=n) throw std::invalid_argument("column outside graph");
+            if(r.size()>size_t(INT_MAX)-edges) throw std::length_error("graph exceeds ldpc edge capacity");
+            edges+=r.size();
+        }
+        for(double x:p) {
+            if(!std::isfinite(x)||x<=0||x>.5) throw std::invalid_argument("priors must be finite in (0,0.5]");
+            weights.push_back(finite(std::log1p(-x)-std::log(x)));
+        }
+        rp.push_back(0); cp.assign(size_t(n)+1,0);
+        // Empty dimensions are handled algebraically, avoiding upstream allocation assumptions.
+        if(m && n) {
+            ldpc::bp::BpSparse pcm(m,n,int(edges));
+            for(int a=0;a<m;++a) for(int i:rows[a]) pcm.insert_entry(a,i);
+            for(int a=0;a<m;++a) {
+                for(auto& e:pcm.iterate_row(a)) { col.push_back(e.col_index); row.push_back(a); ++cp[e.col_index+1]; }
+                rp.push_back(col.size());
+            }
+        } else rp.resize(size_t(m)+1,0);
+        for(int i=0;i<n;++i) cp[i+1]+=cp[i];
+        ce.resize(edges); auto next=cp;
+        for(size_t e=0;e<col.size();++e) ce[next[col[e]]++]=e;
+    }
+    bool valid(const Bits& e,const Bits& s) const {
+        binary(e,n); binary(s,m);
+        for(int a=0;a<m;++a) { uint8_t x=0; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; if(x!=s[a]) return false; }
+        return true;
+    }
+    uint64_t residual_weight(const Bits& e,const Bits& s) const {
+        uint64_t count=0;
+        for(int a=0;a<m;++a) { uint8_t x=s[a]; for(size_t j=rp[a];j<rp[a+1];++j) x^=e[col[j]]; count+=x; }
+        return count;
+    }
+    bool inconsistent_empty_row(const Bits& s) const {
+        for(int a=0;a<m;++a) if(s[a] && rp[a]==rp[a+1]) return true;
+        return false;
+    }
+};
+}
+#endif
diff --git a/src_cpp/osd0_bridge.hpp b/src_cpp/osd0_bridge.hpp
new file mode 100644
index 0000000..b37a583
--- /dev/null
+++ b/src_cpp/osd0_bridge.hpp
@@ -0,0 +1,37 @@
+#ifndef LDPC_OSD0_BRIDGE_HPP
+#define LDPC_OSD0_BRIDGE_HPP
+#include "hybrid_graph.hpp"
+#include "osd.hpp"
+
+namespace ldpc::hybrid {
+struct OsdResult { Bits correction; bool valid=false; };
+// Own all vectors referenced by upstream OsdDecoder, in destruction-safe order.
+// Non-reentrant. No BP object or higher-order candidates exist on this path.
+class Osd0Bridge {
+    std::shared_ptr<const Graph> graph_;
+    Reals probabilities_;
+    std::unique_ptr<ldpc::bp::BpSparse> pcm_;
+    std::unique_ptr<ldpc::osd::OsdDecoder> osd_;
+public:
+    explicit Osd0Bridge(std::shared_ptr<const Graph> graph):graph_(std::move(graph)) {
+        if(!graph_) throw std::invalid_argument("graph required");
+        probabilities_=graph_->probabilities;
+        if(graph_->m && graph_->n) {
+            pcm_=std::make_unique<ldpc::bp::BpSparse>(graph_->m,graph_->n,int(graph_->col.size()));
+            for(size_t e=0;e<graph_->col.size();++e) pcm_->insert_entry(graph_->row[e],graph_->col[e]);
+            osd_=std::make_unique<ldpc::osd::OsdDecoder>(*pcm_,ldpc::osd::COMBINATION_SWEEP,0,probabilities_);
+        }
+    }
+    OsdResult decode(const Bits& syndrome,const Reals& llrs) {
+        binary(syndrome,graph_->m);
+        if(llrs.size()!=size_t(graph_->n)||std::any_of(llrs.begin(),llrs.end(),[](double x){return !std::isfinite(x);}))
+            throw std::invalid_argument("OSD LLRs must be finite with shape (n,)");
+        OsdResult out; out.correction.assign(graph_->n,0);
+        if(osd_) {auto s=syndrome; auto l=llrs; out.correction=osd_->decode(s,l);}
+        out.valid=graph_->valid(out.correction,syndrome);
+        return out;
+    }
+    size_t candidate_count() const {return osd_ ? osd_->osd_candidate_strings.size() : 0;}
+};
+}
+#endif
diff --git a/src_cpp/reference_bp.hpp b/src_cpp/reference_bp.hpp
new file mode 100644
index 0000000..a98fec6
--- /dev/null
+++ b/src_cpp/reference_bp.hpp
@@ -0,0 +1,214 @@
+#ifndef LDPC_REFERENCE_BP_HPP
+#define LDPC_REFERENCE_BP_HPP
+// Opt-in reference flooding sum-product profile. Ordinary ldpc BP is unchanged.
+// Owns graph and priors. decode() is const with per-call buffers: concurrent calls
+// are safe, provided callers do not modify their arguments during a call.
+// Every returned vector owns its memory; no borrowed buffers survive the call.
+#include <algorithm>
+#include <cmath>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace ldpc::reference {
+static_assert(sizeof(double) == 8 && std::numeric_limits<double>::is_iec559 &&
+              std::numeric_limits<double>::digits == 53, "reference BP requires IEEE binary64");
+using Bits = std::vector<int>;
+using Beliefs = std::vector<double>;
+
+enum class Status { CONVERGED, NONCONVERGENCE, LOCAL_CONTRADICTION };
+
+struct Trace {
+    Beliefs beliefs;                  // ascending free-variable IDs
+    Beliefs variable_to_check;        // active edges ordered by (check, variable)
+    Beliefs check_to_variable;
+    Bits decision;                    // complete original vector, fixed bits restored
+};
+
+struct Result {
+    Status status = Status::NONCONVERGENCE;
+    int iterations = 0;               // completed flooding iterations, excludes initialization
+    Bits last_decision;               // not a valid correction unless status is CONVERGED
+    Bits free_ids;
+    Beliefs beliefs;
+    std::vector<Beliefs> history;      // oldest to newest, completed iterations only
+    Beliefs mean_llr;
+    Beliefs reliability;              // abs(mean), not mean(abs)
+    Bits flips;                       // L<0 transitions within retained window only
+    std::vector<Trace> trace;          // optional; includes iteration zero
+};
+
+class ReferenceBp {
+    int n_;
+    std::vector<Bits> rows_;
+    Beliefs weights_;
+
+    static double clip(double v, double limit) {
+        return std::max(-limit, std::min(limit, v));
+    }
+
+public:
+    // rows must be canonical strictly ascending original column IDs; empty rows
+    // and isolated variables are allowed. Priors are finite and in (0, 1/2].
+    ReferenceBp(std::vector<Bits> rows, int n, const Beliefs &probabilities)
+        : n_(n), rows_(std::move(rows)) {
+        if (n < 0 || probabilities.size() != static_cast<std::size_t>(n))
+            throw std::invalid_argument("prior length must equal nonnegative n");
+        if (rows_.size() > static_cast<std::size_t>(std::numeric_limits<int>::max()))
+            throw std::invalid_argument("too many checks");
+        for (const auto &row : rows_) {
+            int previous = -1;
+            for (int i : row) {
+                if (i < 0 || i >= n || i <= previous)
+                    throw std::invalid_argument("rows require sorted unique in-range column IDs");
+                previous = i;
+            }
+        }
+        for (double p : probabilities) {
+            if (!std::isfinite(p) || p <= 0 || p > 0.5)
+                throw std::invalid_argument("priors must be finite in (0,0.5]");
+            weights_.push_back(std::log1p(-p) - std::log(p));
+        }
+    }
+
+    const Beliefs &physical_weights() const { return weights_; }
+    int num_variables() const { return n_; }
+    int num_checks() const { return static_cast<int>(rows_.size()); }
+
+    // Fixed is empty (all free) or n entries: -1 free, 0/1 structurally fixed.
+    // Both fixed values remove edges; fixed ones XOR the residual syndrome.
+    // max_iterations >=1, history_window >=0, 0<llr_max<=30. Cold-start every call.
+    // Results contain beliefs/history only for free_ids; fixed bits have no LLR.
+    Result decode(const Bits &syndrome, int max_iterations = 30,
+                  double llr_max = 25, int history_window = 8,
+                  const Bits &fixed = {}, bool diagnostics = false) const {
+        const int m = num_checks();
+        if (syndrome.size() != rows_.size() || max_iterations < 1 || history_window < 0 ||
+            !std::isfinite(llr_max) || llr_max <= 0 || llr_max > 30)
+            throw std::invalid_argument("invalid syndrome shape or BP numerical settings");
+        for (int bit : syndrome)
+            if (bit != 0 && bit != 1) throw std::invalid_argument("syndrome must be binary");
+        if (!fixed.empty() && fixed.size() != static_cast<std::size_t>(n_))
+            throw std::invalid_argument("fixed mask must have length n");
+        Bits mask = fixed.empty() ? Bits(n_, -1) : fixed;
+        for (int bit : mask)
+            if (bit < -1 || bit > 1) throw std::invalid_argument("fixed values must be -1,0,1");
+        Bits residual = syndrome;
+        Result result;
+        result.last_decision.assign(n_, 0);
+        Bits original_to_free(n_, -1);
+        for (int i = 0; i < n_; ++i) {
+            if (mask[i] < 0) {
+                original_to_free[i] = static_cast<int>(result.free_ids.size());
+                result.free_ids.push_back(i);
+            } else {
+                result.last_decision[i] = mask[i];
+            }
+        }
+        // Edge construction preserves ascending original variable and check order.
+        std::vector<Bits> row_edges(m), column_edges(result.free_ids.size());
+        Bits edge_free;
+        for (int a = 0; a < m; ++a) {
+            for (int i : rows_[a]) {
+                if (mask[i] >= 0) {
+                    residual[a] ^= mask[i];
+                    continue;
+                }
+                if (edge_free.size() >= static_cast<std::size_t>(std::numeric_limits<int>::max()))
+                    throw std::invalid_argument("too many active edges");
+                const int edge = static_cast<int>(edge_free.size());
+                const int free = original_to_free[i];
+                edge_free.push_back(free);
+                row_edges[a].push_back(edge);
+                column_edges[free].push_back(edge);
+            }
+        }
+        Beliefs prior;
+        for (int i : result.free_ids) prior.push_back(clip(weights_[i], llr_max));
+        result.beliefs = prior;
+        Beliefs v_old(edge_free.size()), v_new(edge_free.size()), c_new(edge_free.size(), 0);
+        for (std::size_t edge = 0; edge < edge_free.size(); ++edge) v_old[edge] = prior[edge_free[edge]];
+        if (diagnostics) result.trace.push_back({result.beliefs, v_old, c_new, result.last_decision});
+        for (int a = 0; a < m; ++a) {
+            if (row_edges[a].empty() && residual[a]) {
+                result.status = Status::LOCAL_CONTRADICTION;
+                return result;
+            }
+        }
+        auto valid = [&]() {
+            for (int a = 0; a < m; ++a) {
+                int parity = 0;
+                for (int i : rows_[a]) parity ^= result.last_decision[i];
+                if (parity != syndrome[a]) return false;
+            }
+            return true;
+        };
+        if (valid()) {
+            result.status = Status::CONVERGED;
+            return result;
+        }
+        std::deque<Beliefs> history;
+        const double z_max = std::tanh(llr_max / 2);
+        for (int t = 1; t <= max_iterations; ++t) {
+            // Complete check half-step reads only the previous v buffer.
+            for (int a = 0; a < m; ++a) {
+                const auto &edges = row_edges[a];
+                for (int edge : edges) {
+                    if (edges.size() == 1) {
+                        c_new[edge] = residual[a] ? -llr_max : llr_max;
+                    } else {
+                        double z = residual[a] ? -1.0 : 1.0;
+                        for (int other : edges)
+                            if (other != edge) z *= std::tanh(v_old[other] / 2);
+                        z = clip(z, z_max);
+                        c_new[edge] = clip(2 * std::atanh(z), llr_max);
+                    }
+                }
+            }
+            // Completed c buffer is the only message source for this half-step.
+            for (std::size_t free = 0; free < prior.size(); ++free) {
+                double total = 0;
+                for (int edge : column_edges[free]) total += c_new[edge];
+                result.beliefs[free] = clip(prior[free] + total, llr_max);
+                result.last_decision[result.free_ids[free]] = result.beliefs[free] < 0 ? 1 : 0;
+                for (int edge : column_edges[free]) {
+                    double extrinsic = 0;
+                    for (int other : column_edges[free])
+                        if (other != edge) extrinsic += c_new[other];
+                    v_new[edge] = clip(prior[free] + extrinsic, llr_max);
+                }
+            }
+            result.iterations = t;
+            if (history_window > 0) {
+                if (history.size() == static_cast<std::size_t>(history_window)) history.pop_front();
+                history.push_back(result.beliefs);
+            }
+            if (diagnostics) result.trace.push_back({result.beliefs, v_new, c_new, result.last_decision});
+            if (valid()) {
+                result.status = Status::CONVERGED;
+                break;
+            }
+            v_old.swap(v_new);
+        }
+        result.history.assign(history.begin(), history.end());
+        if (!history.empty()) {
+            result.mean_llr.assign(prior.size(), 0);
+            result.flips.assign(prior.size(), 0);
+            result.reliability.resize(prior.size());
+            for (std::size_t free = 0; free < prior.size(); ++free) {
+                for (std::size_t t = 0; t < history.size(); ++t) {
+                    result.mean_llr[free] += history[t][free];
+                    if (t > 0 && (history[t][free] < 0) != (history[t-1][free] < 0)) ++result.flips[free];
+                }
+                result.mean_llr[free] /= static_cast<double>(history.size());
+                result.reliability[free] = std::abs(result.mean_llr[free]);
+            }
+        }
+        return result;
+    }
+};
+} // namespace ldpc::reference
+#endif
diff --git a/src_cpp/stateful_min_sum.hpp b/src_cpp/stateful_min_sum.hpp
new file mode 100644
index 0000000..08ffeea
--- /dev/null
+++ b/src_cpp/stateful_min_sum.hpp
@@ -0,0 +1,101 @@
+#ifndef LDPC_STATEFUL_MIN_SUM_HPP
+#define LDPC_STATEFUL_MIN_SUM_HPP
+#include "hybrid_graph.hpp"
+#include <functional>
+
+namespace ldpc::hybrid {
+struct Snapshot { Reals fields,sums,llrs,q,z; Bits decision; uint64_t iterations; };
+struct Advance { bool valid=false,cap_hit=false; uint64_t iterations=0; };
+
+// Mutable non-reentrant session; owned edge state, shared immutable graph.
+// reset(s[m]) invalidates previous state, including when input validation fails.
+// Fields/LLRs have n entries; q/z use row-major canonical edge IDs. Snapshot copies.
+class StatefulMinSumSession {
+    std::shared_ptr<const Graph> graph_;
+    double limit_,alpha_;
+    Bits syndrome_;
+    bool ready_=false,fields_ready_=false;
+    Snapshot state_;
+    double clip(double x) const { x=finite(x); return x==0 ? 0.0 : std::max(-limit_,std::min(limit_,x)); }
+    void variables() {
+        const auto& g=*graph_;
+        for(int i=0;i<g.n;++i) {
+            double sum=state_.fields[i];
+            for(size_t j=g.cp[i];j<g.cp[i+1];++j) sum=finite(sum+state_.z[g.ce[j]]);
+            state_.sums[i]=sum; state_.llrs[i]=clip(sum); state_.decision[i]=state_.llrs[i]<=0;
+            for(size_t j=g.cp[i];j<g.cp[i+1];++j) {size_t e=g.ce[j]; state_.q[e]=clip(finite(sum-state_.z[e]));}
+        }
+    }
+public:
+    StatefulMinSumSession(std::shared_ptr<const Graph> graph,double limit=25,double alpha=1):
+        graph_(std::move(graph)),limit_(limit),alpha_(alpha) {
+        if(!graph_ || !std::isfinite(limit)||limit<=0||!std::isfinite(alpha)||alpha<=0||alpha>1)
+            throw std::invalid_argument("finite positive clip and scaling in (0,1] required");
+        auto n=graph_->n; auto edges=graph_->col.size();
+        state_.fields.resize(n); state_.sums.resize(n); state_.llrs.resize(n); state_.decision.resize(n);
+        state_.q.resize(edges); state_.z.resize(edges); state_.iterations=0;
+    }
+    void reset(const Bits& s) {
+        ready_=fields_ready_=false; state_.iterations=0;
+        std::fill(state_.q.begin(),state_.q.end(),0); std::fill(state_.z.begin(),state_.z.end(),0);
+        binary(s,graph_->m); syndrome_=s; ready_=true;
+    }
+    bool replace_fields(const Reals& fields) {
+        if(!ready_) throw std::logic_error("reset required before fields");
+        fields_ready_=false;
+        if(fields.size()!=size_t(graph_->n)||std::any_of(fields.begin(),fields.end(),[](double x){return !std::isfinite(x);})) {
+            ready_=false; throw std::invalid_argument("fields must be finite with shape (n,)");
+        }
+        try { state_.fields=fields; variables(); fields_ready_=true; return valid(); }
+        catch(...) { ready_=false; throw; }
+    }
+    bool replace_hint(const std::vector<std::pair<int,uint8_t>>& pattern,double margin) {
+        try {
+        if(!std::isfinite(margin)||margin<=0) {ready_=false; throw std::invalid_argument("hint margin must be finite and positive");}
+        auto fields=graph_->weights;
+        int previous=-1;
+        for(auto [i,b]:pattern) {
+            if(i<=previous||i>=graph_->n||b>1) {ready_=false; throw std::invalid_argument("hint must be sorted unique in-range binary assignments");}
+            previous=i; fields[i]=finite((b ? -1.0 : 1.0)*finite(fields[i]+margin));
+        }
+        return replace_fields(fields);
+        } catch(...) {ready_=fields_ready_=false;throw;}
+    }
+    bool valid() const { return ready_ && fields_ready_ && graph_->valid(state_.decision,syndrome_); }
+    Advance advance(int count,const std::function<bool()>& cap={}) {
+        if(count<0) throw std::invalid_argument("iteration count must be nonnegative");
+        if(!ready_||!fields_ready_) throw std::logic_error("reset and fields required before iterations");
+        Advance out; out.valid=valid();
+        try {
+            for(int t=0;t<count && !out.valid;++t) {
+                if(cap && cap()) {out.cap_hit=true; break;}
+                const auto& g=*graph_;
+                // All checks read the old q; q is written only after this pass.
+                for(int a=0;a<g.m;++a) {
+                    auto begin=g.rp[a],end=g.rp[a+1];
+                    if(begin==end) continue;
+                    if(end-begin==1) {state_.z[begin]=syndrome_[a] ? -limit_ : limit_; continue;}
+                    double first=std::numeric_limits<double>::infinity(),second=first;
+                    bool sign=bool(syndrome_[a]); size_t min_edge=begin;
+                    for(size_t e=begin;e<end;++e) {
+                        double x=state_.q[e],v=std::abs(x); sign^=x<0;
+                        if(v<first) {second=first; first=v; min_edge=e;} else if(v<second) second=v;
+                    }
+                    for(size_t e=begin;e<end;++e) {
+                        double magnitude=alpha_*(e==min_edge ? second : first);
+                        state_.z[e]=clip((sign^(state_.q[e]<0)) ? -magnitude : magnitude);
+                    }
+                }
+                variables(); ++state_.iterations; ++out.iterations; out.valid=valid();
+            }
+        } catch(...) { ready_=fields_ready_=false; throw; }
+        return out;
+    }
+    uint64_t completed_iterations() const {return state_.iterations;} // completed full iterations, even after an exception
+    Snapshot snapshot() const { if(!ready_||!fields_ready_) throw std::logic_error("no active BP state"); return state_; }
+    const Reals& llrs() const {return state_.llrs;}
+    const Bits& decision() const {return state_.decision;}
+    const Bits& syndrome() const {return syndrome_;}
+};
+}
+#endif
