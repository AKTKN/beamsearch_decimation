+class StatefulMinSumSession:
+    def __init__(self, rows: Sequence[Sequence[int]], n: int, probabilities: Sequence[float], llr_clip: float = 25., scaling_factor: float = 1.) -> None: ...
+    def reset(self, syndrome: Sequence[int]) -> None: ...
+    def replace_fields(self, fields: Sequence[float]) -> bool: ...
+    def replace_hint(self, pattern: Sequence[tuple[int, int]], margin: float) -> bool: ...
+    def advance(self, iterations: int) -> Advance: ...
+    def snapshot(self) -> Snapshot: ...
+class Osd0Bridge:
