+"""Opt-in HSBP-ALG-1.0 sessions; arrays are copied across the Python boundary.
+
+Sessions are mutable and non-reentrant. reset starts a new shot; replace_fields
+retains check messages. advance stops on validity. No sampled truth is accepted.
+C++ production consumers share the native graph and sessions without Python loops.
+"""
+from ._hybrid_bp import StatefulMinSumSession, Osd0Bridge, build_identity
+from .source_files import SOURCE_FILES, source_digest
