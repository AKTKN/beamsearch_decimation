+"""Explicit opt-in build; ordinary upstream setup.py and APIs remain unchanged."""
+from pathlib import Path
+import hashlib
+import subprocess
+from setuptools import Extension, setup
+import pybind11
+
+ROOT = Path(__file__).resolve().parent
+SOURCES = ('src_cpp/reference_bp.hpp', 'src_python/ldpc/reference_bp/bindings.cpp',
+           'src_python/ldpc/reference_bp/__init__.py', 'setup_reference.py')
+digest = hashlib.sha256()
+for name in SOURCES:
+    digest.update(name.encode() + b'\0' + (ROOT / name).read_bytes())
+commit = subprocess.check_output(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], text=True).strip()
+setup(
+    package_dir={'': 'src_python'},
+    ext_modules=[Extension('ldpc.reference_bp._reference_bp',
+        sources=['src_python/ldpc/reference_bp/bindings.cpp'],
+        include_dirs=[pybind11.get_include(), 'src_cpp'], language='c++',
+        define_macros=[('REFERENCE_UPSTREAM_COMMIT', '"' + commit + '"'),
+                       ('REFERENCE_SOURCE_HASH', '"' + digest.hexdigest() + '"')],
+        extra_compile_args=['-O3', '-std=c++17', '-fno-fast-math', '-ffp-contract=off', '-Wall', '-Wextra'])])
