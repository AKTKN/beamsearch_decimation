+"""Build the opt-in AF-BP iteration engine without changing upstream BP-OSD."""
+from pathlib import Path
+import runpy
+import subprocess
+from setuptools import Extension, setup
+import pybind11
+
+ROOT = Path(__file__).resolve().parent
+source = runpy.run_path(str(ROOT / "src_python/ldpc/af_bp/source_files.py"))
+digest = source["source_digest"](ROOT)
+commit = subprocess.check_output(["git", "-C", str(ROOT), "rev-parse", "HEAD"], text=True).strip()
+setup(package_dir={"": "src_python"}, ext_modules=[Extension(
+    "ldpc.af_bp._af_bp", sources=["src_python/ldpc/af_bp/bindings.cpp"],
+    depends=list(source["SOURCE_FILES"]), include_dirs=[pybind11.get_include(), "src_cpp"],
+    language="c++", define_macros=[("AF_BP_UPSTREAM_COMMIT", '"' + commit + '"'),
+                                      ("AF_BP_SOURCE_HASH", '"' + digest + '"')],
+    extra_compile_args=["-O3", "-std=c++17", "-fno-fast-math", "-ffp-contract=off", "-Wall", "-Wextra"])] )
