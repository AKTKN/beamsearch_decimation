+++ b/src_python/ldpc/hybrid_bp/source_files.py
@@ -0,0 +1,21 @@
+"""Complete opt-in source/build digest, including pinned transitive native headers."""
+from pathlib import Path
+import hashlib
+
+SOURCE_FILES = tuple('src_cpp/' + name + '.hpp' for name in (
+    'hybrid_graph', 'stateful_min_sum', 'decimated_bp', 'osd0_bridge', 'bp', 'osd', 'sort',
+    'util', 'gf2sparse', 'gf2sparse_linalg', 'sparse_matrix_base', 'sparse_matrix_util', 'rng',
+)) + ('src_python/ldpc/hybrid_bp/bindings.cpp', 'src_python/ldpc/hybrid_bp/__init__.py',
+     'src_python/ldpc/hybrid_bp/__init__.pyi', 'src_python/ldpc/hybrid_bp/source_files.py', 'setup_hybrid.py')
+
+
+def source_digest(root: Path) -> str:
+    """Hash ordered relative names and bytes; missing files raise OSError."""
+    digest = hashlib.sha256()
+    for name in SOURCE_FILES:
+        digest.update(name.encode() + b'\0' + (root / name).read_bytes())
+    return digest.hexdigest()
+
+
+if __name__ == '__main__':
+    print(source_digest(Path(__file__).resolve().parents[3]))
