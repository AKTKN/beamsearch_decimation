+++ b/src_python/ldpc/af_bp/__init__.py
@@ -0,0 +1,162 @@
+"""Independent AF-BP-ready Min-Sum engine; all iteration work is native C++.
+
+Rows and all returned arrays are copied. One decoder may be reused for separate
+shots; each decode starts a new native state and seeded RNG. Concurrent calls on
+the same immutable decoder are safe, though the wrapper does not promise that
+third-party matrix objects can be mutated concurrently.
+"""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from pathlib import Path
+from typing import Literal
+import math
+
+import numpy as np
+from numpy.typing import ArrayLike, NDArray
+from scipy import sparse
+
+from . import _af_bp
+from .source_files import source_digest
+
+Variant = Literal["parallel", "serial", "qdither"]
+
+
+@dataclass(frozen=True)
+class BPConfig:
+    variant: Variant = "parallel"
+    max_iterations: int = 30
+    scaling_factor: float = 1.0
+    history_window: int = 8
+    serial_order: Literal["natural", "random_per_iteration"] = "natural"
+    seed: int = 0
+    phase1_iterations: int = 30
+    num_chains: int = 0
+    chain_iterations: int = 30
+    alpha: float = 0.0
+    beta: float = 1.0
+    rho: float = 0.0
+    qdither_handoff: Literal["paper", "graph_warm"] = "paper"
+    max_total_iterations: int | None = None
+
+    def __post_init__(self) -> None:
+        if self.variant not in ("parallel", "serial", "qdither"):
+            raise ValueError("invalid BP variant")
+        if self.serial_order not in ("natural", "random_per_iteration"):
+            raise ValueError("invalid serial check order")
+        if self.qdither_handoff not in ("paper", "graph_warm"):
+            raise ValueError("invalid qDither handoff mode")
+        for name in ("max_iterations", "phase1_iterations", "num_chains", "chain_iterations", "seed"):
+            value = getattr(self, name)
+            if type(value) is not int or value < 0:
+                raise ValueError(f"{name} must be a nonnegative integer")
+        if type(self.history_window) is not int or self.history_window < 1:
+            raise ValueError("history_window must be a positive integer")
+        if self.max_total_iterations is not None and (
+            type(self.max_total_iterations) is not int or self.max_total_iterations < 0
+        ):
+            raise ValueError("max_total_iterations must be a nonnegative integer or None")
+        if self.seed >= 2**64:
+            raise ValueError("seed must fit uint64")
+        if not (math.isfinite(self.scaling_factor) and 0 < self.scaling_factor <= 1):
+            raise ValueError("scaling_factor must be in (0, 1]")
+        if not all(math.isfinite(v) for v in (self.alpha, self.beta, self.rho)) or not (
+            0 <= self.alpha <= self.beta <= 1 and 0 <= self.rho <= 1
+        ):
+            raise ValueError("qDither alpha, beta, rho must be probabilities")
+
+
+@dataclass(frozen=True)
+class BPResult:
+    success: bool
+    correction: NDArray[np.uint8]
+    final_llrs: NDArray[np.float64]
+    total_iterations: int
+    phase1_iterations_executed: int
+    chain_iterations_executed: tuple[int, ...]
+    trailing_history: NDArray[np.float64]
+    attempts: tuple[object, ...]
+    budget_truncated: bool
+
+
+class BPDecoder:
+    """Construct from binary CSR/dense H (m,n) and finite base LLRs (n,).
+
+    decode returns an owned hard decision. decode_detailed additionally returns
+    success, final marginals, exact iteration count and final-attempt history.
+    Input shape/value errors raise ValueError; stale compiled sources raise
+    RuntimeError. The physical base LLR vector is never modified by q_init.
+    """
+
+    def __init__(self, check_matrix: ArrayLike | sparse.spmatrix,
+                 base_llrs: ArrayLike, config: BPConfig = BPConfig()) -> None:
+        if not isinstance(config, BPConfig):
+            raise TypeError("config must be BPConfig")
+        matrix = sparse.csr_matrix(check_matrix)
+        if matrix.ndim != 2 or np.any(matrix.data != 1):
+            raise ValueError("check_matrix must be binary")
+        matrix.sum_duplicates()
+        if np.any(matrix.data != 1):
+            raise ValueError("check_matrix must be binary")
+        matrix.sort_indices()
+        base = np.asarray(base_llrs, dtype=np.float64)
+        if base.shape != (matrix.shape[1],) or not np.isfinite(base).all():
+            raise ValueError("base_llrs must be finite with shape (n,)")
+        root = Path(__file__).resolve().parents[3]
+        if _af_bp.build_identity()["source_sha256"] != source_digest(root):
+            raise RuntimeError("stale ldpc.af_bp native binary; rebuild setup_af_bp.py")
+        native = _af_bp.Settings()
+        for name in BPConfig.__dataclass_fields__:
+            value = getattr(config, name)
+            setattr(native, name, -1 if name == "max_total_iterations" and value is None else value)
+        rows = [matrix.indices[matrix.indptr[a]:matrix.indptr[a + 1]].tolist()
+                for a in range(matrix.shape[0])]
+        self._native = _af_bp.Decoder(rows, base.tolist(), native)
+        self.config = config
+        self.shape = matrix.shape
+
+    def decode_detailed(self, syndrome: ArrayLike, *, q_init: ArrayLike | None = None,
+                        diagnostics: bool = False) -> BPResult:
+        syndrome_array = np.asarray(syndrome)
+        if syndrome_array.shape != (self.shape[0],) or not np.isin(syndrome_array, (0, 1)).all():
+            raise ValueError("syndrome must be binary with shape (m,)")
+        handoff: list[float] = []
+        if q_init is not None:
+            q = np.asarray(q_init, dtype=np.float64)
+            if q.shape != (self.shape[1],) or not np.isfinite(q).all():
+                raise ValueError("q_init must be finite with shape (n,)")
+            handoff = q.tolist()
+        native = self._native.decode_detailed(syndrome_array.astype(np.int32).tolist(),
+                                               handoff, diagnostics)
+        history = np.asarray(native.trailing_history, dtype=np.float64).reshape(-1, self.shape[1])
+        return BPResult(bool(native.success), np.asarray(native.correction, dtype=np.uint8),
+                        np.asarray(native.final_llrs, dtype=np.float64),
+                        int(native.total_iterations), int(native.phase1_iterations_executed),
+                        tuple(native.chain_iterations_executed), history,
+                        tuple(native.attempts), bool(native.budget_truncated))
+
+    def decode(self, syndrome: ArrayLike, *, q_init: ArrayLike | None = None) -> NDArray[np.uint8]:
+        """Return the owned hard decision; inspect success via decode_detailed."""
+        return self.decode_detailed(syndrome, q_init=q_init).correction
+
+
+class QditherDecoder(BPDecoder):
+    """Standalone Python entrypoint for qDither with explicit validated options."""
+
+    def __init__(self, check_matrix: ArrayLike | sparse.spmatrix,
+                 base_llrs: ArrayLike, *, phase1_iterations: int = 30,
+                 num_chains: int = 0, chain_iterations: int = 30,
+                 alpha: float = 0.0, beta: float = 1.0, rho: float = 0.0,
+                 scaling_factor: float = 1.0, history_window: int = 8,
+                 seed: int = 0, handoff: Literal["paper", "graph_warm"] = "paper",
+                 max_total_iterations: int | None = None) -> None:
+        super().__init__(check_matrix, base_llrs, BPConfig(
+            variant="qdither", phase1_iterations=phase1_iterations,
+            num_chains=num_chains, chain_iterations=chain_iterations,
+            alpha=alpha, beta=beta, rho=rho, scaling_factor=scaling_factor,
+            history_window=history_window, seed=seed, qdither_handoff=handoff,
+            max_total_iterations=max_total_iterations))
+
+
+build_identity = _af_bp.build_identity
+__all__ = ["BPConfig", "BPResult", "BPDecoder", "QditherDecoder", "build_identity"]
