# Local scientific artifacts and mutable reports (keep directory documentation).
/simulation_data/*
!/simulation_data/README.md
/assets/*
!/assets/README.md

# Editable experiment settings and analysis notebooks; templates are versioned.
/config/**/*.yaml
/config/**/*.yml
*.ipynb
.ipynb_checkpoints/

# Pinned dependencies are restored by build_dependencies from locks and patches.
/external_lib/*
!/external_lib/README.md
!/external_lib/manifest.lock.json
!/external_lib/patches/

legacy/
!/config/legacy/
!/config/legacy/hybrid/
!/config/legacy/hybrid/*.yaml.example
!/src/qec_bp_benchmark/native/legacy/
!/src/qec_bp_benchmark/native/legacy/*.hpp
!/docs/legacy/
!/docs/legacy/hybrid_frontier_bp_beam/
!/docs/legacy/hybrid_frontier_bp_beam/*
!/analysis/legacy/
!/analysis/legacy/simple_frontier.py

# Build products and caches.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/
*.egg-info/
build/
dist/
*.so
*.dylib
*.dll
*.o
*.a
*.whl
.venv/
venv/
.coverage
htmlcov/

# Local credentials and editor state.
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store

# Versioned SEARCH-BP-1.0 architectural archive.
!/src/qec_bp_benchmark/legacy/
!/src/qec_bp_benchmark/storage/legacy/
!/tests/legacy/
