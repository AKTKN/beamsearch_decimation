# Non-production paired AF-BP n_fact check.
experiment:
  name: af_bp_n_fact
  purpose: Bounded factorization-count construction check only
  codes:
  - family: surface
    distances: [3]
circuit:
  cache: ../simulation_data
noise:
  rates: [0.003]
sampling:
  shots_per_point: 2
  batch_size: 2
  warmup_count: 0
execution:
  workers: 1
output:
  root: ../assets/runs
decoders:
- profile: af_bp
  name: n_fact_1
  n_fact: 1
  initial_iteration_budget: 2
  transformed_iteration_budget: 2
  graph_rounds: 1
- profile: af_bp
  name: n_fact_2
  n_fact: 2
  initial_iteration_budget: 2
  transformed_iteration_budget: 2
  graph_rounds: 1
