# Bounded, dry-run-oriented HSBP-FB-2.0 controls.  The decoder names are part of
# their identities.  Do not interpret this small grid as performance evidence.
config_schema_version: hsbp_fb_config/1
experiment:
  name: hybrid_frontier_bp_beam_controlled_variants
  purpose: Ordered architecture and ablation validation; not a production sweep
  codes: [{family: surface, distances: [3]}, {family: bb72, distances: [6]}]
  memory_basis: Z
  sector: Z_checks
  round_rule: distance
circuit:
  surface_provider: stim
  bb_provider: qldpc
  surface_schedule: rotated_memory_z
  bb_schedule: edge_coloring
  edge_coloring_strategy: smallest_last
  boundary: noisy_prepare_extract_readout
  cache: ../simulation_data
dem: {decompose_errors: false, approximate_disjoint_errors: false, allow_gauge_detectors: false,
  sector_mapping: measurement_provenance, merge: none, normalization: remove_zero_reject_above_half}
noise:
  profile: circuit_depolarizing
  rates: [0.003]
  multipliers: {one_qubit: 1.0, two_qubit: 1.0, idle: 1.0, reset: 1.0, measurement: 1.0}
sampling: {shots_per_point: 8, batch_size: 4, master_seed: 20260922, warmup_seed: 20260923, warmup_count: 1}
execution: {workers: 1}
timing: {mode: isolated_latency, profiling: phases}
output:
  root: ../assets/runs
  layout: typed_datasets
  data_schema_version: hsbp_fb_parquet/1
  parquet: {compression: zstd, compression_level: 3, shots_per_flush: 1024, atomic_batch_commit: true}
  telemetry: {candidate_updates: true, beam_membership: true, solution_events: true,
    trace_search_nodes: false, raw_bp_messages: false, per_iteration_trace: false}
decoders:
  # Unspecified v2 fields below resolve to the same common 8-cycle, 64-expansion,
  # Fixed per-candidate-visit iteration defaults. The resolved JSON is the identity authority.
  - {kind: hybrid_frontier_bp_beam_osd0, profile: hybrid_frontier_bp_beam_ms_osd0_v2,
     name: v2_width2_residual_ancestor_soft_guided}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_width1
    bp: {beam_width: 1, admissions_per_cycle: 1}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_width4
    bp: {beam_width: 4, admissions_per_cycle: 4}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_physical_only_retention
    bp: {retention_score: physical_only}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_cold_states
    bp: {state_inheritance: cold}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_no_hints
    bp: {hint_mode: none}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_search_plus_cs0
    bp: {enabled: false, beam_width: 0, admissions_per_cycle: 0,
      max_total_iterations: 0,
      max_iterations_per_candidate_per_cycle: 0}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_detector_beam15
    search: {det_beam: 15}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_bounded_improve_k2
    stopping: {mode: bounded_improve, post_solution_cycles: 2}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_channel_only_osd
    fallback: {llr_source: channel_only}
  - kind: hybrid_frontier_bp_beam_osd0
    profile: hybrid_frontier_bp_beam_ms_osd0_v2
    name: v2_field_release_osd
    fallback: {llr_source: best_retained_release}
  - profile: hybrid_search_soft_ms_osd0_v1
    name: v1_high_budget
    search: {max_depth: 10, max_cycles: 8, expansions_per_cycle: 8,
      max_generated_nodes: 4096, detector_order: canonical_index,
      branch_order: physical_weight_then_index, heuristic: residual_fractional_cover,
      goal_test: on_generation, guidance_selection: best_unused_generated_pattern,
      prefix_cpu_budget_ns: null}
    bp: {enabled: true, method: minimum_sum, schedule: parallel,
      iterations_per_cycle: 20, scaling_factor: 1.0, llr_clip: 25.0,
      hard_decision_zero: one, warm_start: true,
      hint_policy: signed_channel_magnitude_plus_margin, hint_margin_llr: 8.0,
      replace_previous_hint: true}
  - {profile: beam8, name: beam8_published}
  - {profile: bposd_ms30_cs10, name: bposd_ms30_cs10}
  - {profile: bposd_ms30_cs0, name: unbiased_bp_cs0}
