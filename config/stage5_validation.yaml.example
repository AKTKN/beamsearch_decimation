# Four-shot real-backend software validation, not a performance experiment.
experiment:
  name: stage5_validation
  codes:
    - {family: surface, distances: [5, 7, 9]}
    - {family: bb72, distances: [6]}
noise: {rates: [0.001]}
circuit: {cache: ../simulation_data}
decoders:
  - {profile: screened_reference}
  - {profile: bposd_ms30_cs10}
  - {profile: beam8}
sampling: {shots_per_point: 4, batch_size: 3, master_seed: 20260920, warmup_seed: 20260921, warmup_count: 1}
execution: {workers: 2}
timing: {mode: throughput}
output: {root: ../assets/runs}
