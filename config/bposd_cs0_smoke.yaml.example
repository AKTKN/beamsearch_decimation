# Single-baseline order-zero smoke; no production sweep.
experiment:
  name: bposd_cs0_smoke
  purpose: Validate configurable ordinary BP-OSD order zero
  codes:
  - family: surface
    distances: [3]
circuit:
  cache: ../simulation_data
noise:
  rates: [0.003]
sampling:
  shots_per_point: 2
  batch_size: 2
  warmup_count: 0
execution:
  workers: 1
output:
  root: ../assets/runs
decoders:
- profile: bposd
  osd_order: 0
