# Non-production two-shot AF-BP service smoke.
experiment:
  name: af_bp_smoke
  purpose: Bounded AF-BP integration check only
  codes:
  - family: surface
    distances: [3]
circuit:
  cache: ../simulation_data
noise:
  rates: [0.003]
sampling:
  shots_per_point: 2
  batch_size: 2
  warmup_count: 0
execution:
  workers: 1
output:
  root: ../assets/runs
decoders:
- profile: af_bp
  initial_iteration_budget: 2
  transformed_iteration_budget: 2
  graph_rounds: 1
  n_fact: 1
