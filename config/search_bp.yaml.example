# Smoke-sized SEARCH-BP-2.1 paired integration example; no production sweep.
# Complete defaults and constraints: docs/search_bp_implementation.md.
# This example overrides default initial/candidate BP budgets 30/20 and W=8
# with 4/4 and W=2. Minimal results have exactly six columns; profiling is off.
config_schema_version: search_bp_config/4
experiment:
  name: search_bp_smoke
  purpose: SEARCH-BP-2.1 smoke validation
  codes:
  - family: surface
    distances:
    - 3
  - family: bb72
    distances:
    - 6
  memory_basis: Z
  sector: Z_checks
  round_rule: distance
circuit:
  surface_provider: stim
  bb_provider: qldpc
  surface_schedule: rotated_memory_z
  bb_schedule: edge_coloring
  edge_coloring_strategy: smallest_last
  boundary: noisy_prepare_extract_readout
  cache: ../simulation_data
dem:
  decompose_errors: false
  approximate_disjoint_errors: false
  allow_gauge_detectors: false
  sector_mapping: measurement_provenance
  merge: none
  normalization: remove_zero_reject_above_half
noise:
  profile: circuit_depolarizing
  rates:
  - 0.003
  multipliers:
    one_qubit: 1.0
    two_qubit: 1.0
    idle: 1.0
    reset: 1.0
    measurement: 1.0
sampling:
  shots_per_point: 8
  batch_size: 4
  master_seed: 20260922
  warmup_seed: 20260923
  warmup_count: 1
execution:
  workers: 1
timing:
  mode: throughput
  profiling: none
output:
  root: ../assets/runs
  layout: minimal_results
  data_schema_version: search_bp_results/2
  parquet:
    compression: zstd
    compression_level: 3
    shots_per_flush: 1024
decoders:
- kind: search_bp
  profile: search_bp
  name: search_bp
  algorithm_version: SEARCH-BP-2.1
  osd_fallback: true
  bp:
    initial_iterations: 4
    candidate_iterations: 4
    history_window: 2
    average_llr_clip: 25.0
    scaling_factor: 1.0
  search:
    selected_checks: 2
    local_variables: 4
    local_variable_policy: refresh_descendant
    max_fixations: 2
    max_cycles: 2
    beta: 1.0
    guidance_strength: 1.0
  admission:
    k_run: 4
    k_keep: 2
- profile: beam8
- profile: bposd_ms30_cs10
