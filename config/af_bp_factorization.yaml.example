# Non-production paired AF-BP factorization-policy check.
experiment:
  name: af_bp_factorization
  purpose: Bounded policy construction check only
  codes:
  - family: surface
    distances: [3]
circuit:
  cache: ../simulation_data
noise:
  rates: [0.003]
sampling:
  shots_per_point: 2
  batch_size: 2
  warmup_count: 0
execution:
  workers: 1
output:
  root: ../assets/runs
decoders:
- profile: af_bp
  name: adaptive_cycle
  factorization_policy: adaptive_cycle
  initial_iteration_budget: 2
  transformed_iteration_budget: 2
  graph_rounds: 1
- profile: af_bp
  name: shen_cycle_count
  factorization_policy: shen_cycle_count
  initial_iteration_budget: 2
  transformed_iteration_budget: 2
  graph_rounds: 1
